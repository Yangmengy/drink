  },
  {
    "id": "cocktail-gin-07",
    "name_zh": "新加坡司令",
    "name_en": "Singapore Sling",
    "category": "Gin",
    "tags": ["Contemporary Classics", "热带", "果味"],
    "description": "复杂的配方造就了层次极为丰富的热带水果风味，鲜艳的粉红色外观令人垂涎。",
    "story": "由华裔酒保严崇文（Ngiam Tong Boon）在1915年于新加坡莱佛士酒店的长吧（Long Bar）创造。当时女性不宜在公共场合饮用烈酒，他便特意调制了这款看起来像果汁的粉色烈性鸡尾酒，一举成名。",
    "ingredients": [
      { "name_zh": "金酒", "name_en": "Gin", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "樱桃利口酒", "name_en": "Cherry Liqueur", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "君度", "name_en": "Cointreau", "amount": 7.5, "unit": "ml", "is_optional": false },
      { "name_zh": "法国廊酒", "name_en": "D.O.M Bénédictine", "amount": 7.5, "unit": "ml", "is_optional": false },
      { "name_zh": "红石榴糖浆", "name_en": "Grenadine", "amount": 10, "unit": "ml", "is_optional": false },
      { "name_zh": "菠萝汁", "name_en": "Pineapple Juice", "amount": 120, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜青柠汁", "name_en": "Lime Juice", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "安哥斯图拉苦精", "name_en": "Angostura Bitters", "amount": 1, "unit": "dash", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将所有原料倒入摇酒壶中。" },
      { "step_number": 2, "instruction": "加入冰块，剧烈摇晃至起泡。" },
      { "step_number": 3, "instruction": "倒入装有新鲜冰块的高筒杯或飓风杯中。" },
      { "step_number": 4, "instruction": "用菠萝片和樱桃进行华丽装饰。" }
    ],
    "method": "shake",
    "glass_type": "hurricane",
    "ice_type": "cubed",
    "garnish": "菠萝片与马拉斯奇诺樱桃",
    "difficulty": 4,
    "abv": 15.0,
    "prep_time": 5,
    "flavor_profile": { "sweet": 4, "sour": 2, "bitter": 1, "strong": 2 },
    "occasion": ["party", "beach"],
    "season": ["summer"],
    "mood": ["tropical", "cheerful"],
    "image_url": "singapore_sling.png",
    "color": "#FF69B4",
    "origin": "Singapore",
    "year_created": 1915,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-gin-08",
    "name_zh": "法式75",
    "name_en": "French 75",
    "category": "Gin",
    "tags": ["Contemporary Classics", "香槟", "气泡", "优雅"],
    "description": "起泡酒的奢华与金酒的凛冽交织，口感明快，有着如大炮般的后劲。",
    "story": "诞生于一战时期的巴黎纽约酒吧。据说喝下这杯酒的后劲，就像被当时法军主力火炮“法国75毫米野战炮”轰中了一样，威力惊人却又令人兴奋。",
    "ingredients": [
      { "name_zh": "金酒", "name_en": "Gin", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜柠檬汁", "name_en": "Lemon Juice", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "单糖浆", "name_en": "Simple Syrup", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "香槟", "name_en": "Champagne", "amount": 60, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将金酒、柠檬汁和糖浆加冰摇匀。" },
      { "step_number": 2, "instruction": "过滤至冰镇的长笛香槟杯中。" },
      { "step_number": 3, "instruction": "缓缓注满冰镇过的香槟。" },
      { "step_number": 4, "instruction": "轻轻提拉混合，放上一条卷曲的柠檬皮作为装饰。" }
    ],
    "method": "shake",
    "glass_type": "flute",
    "ice_type": "none",
    "garnish": "柠檬皮卷",
    "difficulty": 2,
    "abv": 15.0,
    "prep_time": 3,
    "flavor_profile": { "sweet": 2, "sour": 3, "bitter": 1, "strong": 3 },
    "occasion": ["celebration", "party", "formal"],
    "season": ["spring", "summer"],
    "mood": ["celebratory", "elegant"],
    "image_url": "french_75.png",
    "color": "#FFFACD",
    "origin": "Paris, France",
    "year_created": 1915,
    "source": "IBA Official",
