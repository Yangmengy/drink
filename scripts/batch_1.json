[
  {
    "id": "cocktail-gin-01",
    "name_zh": "干马天尼",
    "name_en": "Dry Martini",
    "category": "Gin",
    "tags": ["The Unforgettables", "强劲", "经典", "餐前"],
    "description": "鸡尾酒之王，极简而纯粹。由金酒与干味美思完美平衡，散发迷人的植物香气。",
    "story": "干马天尼的起源众说纷纭，有人说它诞生于淘金热时期的加州，也有人认为它是曼哈顿的变体。不论如何，在007电影和丘吉尔等名人的推波助澜下，它成为了优雅与成熟的绝对代名词。",
    "ingredients": [
      { "name_zh": "金酒", "name_en": "Gin", "amount": 60, "unit": "ml", "is_optional": false },
      { "name_zh": "干味美思", "name_en": "Dry Vermouth", "amount": 10, "unit": "ml", "is_optional": false },
      { "name_zh": "橄榄", "name_en": "Olive", "amount": 1, "unit": "颗", "is_optional": true }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将冰块装入调酒杯（Mixing Glass）中。" },
      { "step_number": 2, "instruction": "倒入金酒和干味美思。" },
      { "step_number": 3, "instruction": "用吧勺轻轻搅拌（Stir）约30秒至充分冷却。" },
      { "step_number": 4, "instruction": "用滤冰器将酒液滤入冰镇过的马天尼杯中。" },
      { "step_number": 5, "instruction": "以一颗青橄榄或柠檬皮卷作为装饰。" }
    ],
    "method": "stir",
    "glass_type": "martini",
    "ice_type": "none",
    "garnish": "青橄榄或柠檬皮卷",
    "difficulty": 3,
    "abv": 28.5,
    "prep_time": 3,
    "flavor_profile": { "sweet": 1, "sour": 0, "bitter": 3, "strong": 5 },
    "occasion": ["dinner", "bar", "formal"],
    "season": ["winter", "autumn", "spring", "summer"],
    "mood": ["elegant", "calm", "classic"],
    "image_url": "martini.png",
    "color": "#FDFDFD",
    "origin": "USA",
    "year_created": 1880,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-gin-02",
    "name_zh": "尼格罗尼",
    "name_en": "Negroni",
    "category": "Gin",
    "tags": ["The Unforgettables", "苦甜", "经典", "餐前"],
    "description": "意大利的经典之作。三种酒1:1:1的黄金比例，苦中带甜，风味深邃复杂。",
    "story": "1919年的佛罗伦萨，卡米洛·尼格罗尼伯爵（Count Camillo Negroni）在Casoni酒吧要求酒保将他的Americano鸡尾酒里的苏打水换成金酒以增加烈度。这款酒因此得名，并成为世界上最伟大的开胃酒之一。",
    "ingredients": [
      { "name_zh": "金酒", "name_en": "Gin", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "金巴利", "name_en": "Campari", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "甜味美思", "name_en": "Sweet Red Vermouth", "amount": 30, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在古典杯中放入一块大老冰。" },
      { "step_number": 2, "instruction": "依次倒入金酒、金巴利和甜味美思。" },
      { "step_number": 3, "instruction": "用吧勺轻轻搅拌15-20秒使其冷却并适度稀释。" },
      { "step_number": 4, "instruction": "切一块橙皮，在酒面捏出精油后，投入杯中作为装饰。" }
    ],
    "method": "build",
    "glass_type": "old-fashioned",
    "ice_type": "block",
    "garnish": "橙皮",
    "difficulty": 2,
    "abv": 24.0,
    "prep_time": 2,
    "flavor_profile": { "sweet": 3, "sour": 0, "bitter": 4, "strong": 4 },
    "occasion": ["dinner", "party", "bar"],
    "season": ["autumn", "winter"],
    "mood": ["sophisticated", "relaxing"],
    "image_url": "negroni.png",
    "color": "#8B0000",
    "origin": "Florence, Italy",
    "year_created": 1919,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-gin-03",
    "name_zh": "金汤力",
    "name_en": "Gin & Tonic",
    "category": "Gin",
    "tags": ["清爽", "气泡", "夏日"],
    "description": "最广为人知的金酒长饮。奎宁水的微苦与金酒的杜松子香气完美结合，气泡升腾，极致清凉。",
    "story": "19世纪在印度的英国东印度公司士兵为了预防疟疾，需要饮用含有奎宁的汤力水。由于汤力水极为苦涩，他们开始向其中加入分配给他们的金酒、糖和青柠，意外诞生了这款流芳百世的清凉饮品。",
    "ingredients": [
      { "name_zh": "金酒", "name_en": "Gin", "amount": 50, "unit": "ml", "is_optional": false },
      { "name_zh": "汤力水", "name_en": "Tonic Water", "amount": 120, "unit": "ml", "is_optional": false },
      { "name_zh": "青柠", "name_en": "Lime", "amount": 1, "unit": "片", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在海波杯或大杯中装满冰块。" },
      { "step_number": 2, "instruction": "倒入金酒。" },
      { "step_number": 3, "instruction": "沿杯壁缓缓倒入汤力水，保持气泡感。" },
      { "step_number": 4, "instruction": "轻轻提拉吧勺一次混合，挤入青柠汁并投入青柠片装饰。" }
    ],
    "method": "build",
    "glass_type": "highball",
    "ice_type": "cubed",
    "garnish": "青柠片或柠檬片",
    "difficulty": 1,
    "abv": 11.0,
    "prep_time": 2,
    "flavor_profile": { "sweet": 2, "sour": 2, "bitter": 2, "strong": 2 },
    "occasion": ["casual", "summer", "home"],
    "season": ["summer", "spring"],
    "mood": ["refreshing", "easygoing"],
    "image_url": "gin_and_tonic.png",
    "color": "#E0FFFF",
    "origin": "India (British Empire)",
    "year_created": 1850,
    "source": "Classic",
    "is_iba": false
  },
  {
    "id": "cocktail-gin-04",
    "name_zh": "吉姆雷特",
    "name_en": "Gimlet",
    "category": "Gin",
    "tags": ["Contemporary Classics", "酸甜", "清爽"],
    "description": "极简的酸甜平衡艺术。金酒的植物芬芳被青柠的酸冽彻底激发，锐利而迷人。",
    "story": "Gimlet的名字可能来源于一种叫做gimlet的钻孔工具，寓意其口感如锥子般锐利刺骨。另一种说法是为了纪念英国海军外科医生Thomas Gimlette，他提倡在金酒中加入青柠汁来预防坏血病。",
    "ingredients": [
      { "name_zh": "金酒", "name_en": "Gin", "amount": 60, "unit": "ml", "is_optional": false },
      { "name_zh": "鲜榨青柠汁", "name_en": "Lime Juice", "amount": 20, "unit": "ml", "is_optional": false },
      { "name_zh": "单糖浆", "name_en": "Simple Syrup", "amount": 15, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将金酒、青柠汁和糖浆倒入摇酒壶。" },
      { "step_number": 2, "instruction": "加入大量冰块，用力摇晃（Shake）10-15秒。" },
      { "step_number": 3, "instruction": "双重过滤（Double Strain）至冰镇过的碟形杯中。" },
      { "step_number": 4, "instruction": "以一片青柠作为装饰。" }
    ],
    "method": "shake",
    "glass_type": "coupe",
    "ice_type": "none",
    "garnish": "青柠片",
    "difficulty": 2,
    "abv": 22.0,
    "prep_time": 3,
    "flavor_profile": { "sweet": 2, "sour": 4, "bitter": 0, "strong": 3 },
    "occasion": ["dinner", "bar"],
    "season": ["summer", "spring"],
    "mood": ["sharp", "elegant"],
    "image_url": "gimlet.png",
    "color": "#E6F8E0",
    "origin": "UK",
    "year_created": 1928,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-gin-05",
    "name_zh": "飞行",
    "name_en": "Aviation",
    "category": "Gin",
    "tags": ["The Unforgettables", "花香", "紫色", "酸甜"],
    "description": "呈现梦幻的淡紫色，黑樱桃与紫罗兰的馥郁花果香在舌尖绽放，如漫步云端。",
    "story": "诞生于20世纪初，当时的航空业刚刚起步，象征着人类探索天空的浪漫主义。紫罗兰利口酒赋予了它如同天空般梦幻的淡紫色，带给人翱翔天际的无限遐想。",
    "ingredients": [
      { "name_zh": "金酒", "name_en": "Gin", "amount": 45, "unit": "ml", "is_optional": false },
      { "name_zh": "黑樱桃利口酒", "name_en": "Maraschino Liqueur", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜柠檬汁", "name_en": "Lemon Juice", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "紫罗兰利口酒", "name_en": "Crème de Violette", "amount": 5, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将所有原料倒入摇酒壶中。" },
      { "step_number": 2, "instruction": "加入冰块，充分摇晃（Shake）至酒壶外壁结霜。" },
      { "step_number": 3, "instruction": "过滤至冰镇好的碟形杯或马天尼杯中。" },
      { "step_number": 4, "instruction": "沉入一颗马拉斯奇诺樱桃作为装饰。" }
    ],
    "method": "shake",
    "glass_type": "coupe",
    "ice_type": "none",
    "garnish": "马拉斯奇诺樱桃",
    "difficulty": 3,
    "abv": 23.0,
    "prep_time": 3,
    "flavor_profile": { "sweet": 3, "sour": 3, "bitter": 1, "strong": 3 },
    "occasion": ["party", "bar", "evening"],
    "season": ["spring"],
    "mood": ["dreamy", "romantic"],
    "image_url": "aviation.png",
    "color": "#D8BFD8",
