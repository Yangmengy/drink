  },
  {
    "id": "cocktail-gin-06",
    "name_zh": "汤姆·柯林斯",
    "name_en": "Tom Collins",
    "category": "Gin",
    "tags": ["The Unforgettables", "气泡", "清爽", "夏日"],
    "description": "简单直白的解渴利器。清新的柠檬酸味和苏打水的气泡完美中和了烈酒的灼烧感。",
    "story": "1874年的纽约流传着一个叫“Tom Collins”的恶作剧：人们会走进酒馆，告诉你有个叫Tom Collins的人在隔壁酒吧说你的坏话。当你气冲冲跑过去找他时，酒保就会递给你这杯以此命名的清凉饮料来降降火。",
    "ingredients": [
      { "name_zh": "老汤姆金酒或干金酒", "name_en": "Old Tom Gin or Dry Gin", "amount": 45, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜柠檬汁", "name_en": "Lemon Juice", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "单糖浆", "name_en": "Simple Syrup", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "苏打水", "name_en": "Soda Water", "amount": 60, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在摇酒壶中加入金酒、柠檬汁和糖浆，加冰摇匀。" },
      { "step_number": 2, "instruction": "将酒液过滤到装满冰块的柯林杯中。" },
      { "step_number": 3, "instruction": "最后加满苏打水，轻轻搅拌提拉。" },
      { "step_number": 4, "instruction": "用柠檬片和樱桃进行装饰。" }
    ],
    "method": "shake",
    "glass_type": "collins",
    "ice_type": "cubed",
    "garnish": "柠檬片与樱桃",
    "difficulty": 2,
    "abv": 12.0,
    "prep_time": 3,
    "flavor_profile": { "sweet": 2, "sour": 3, "bitter": 0, "strong": 2 },
    "occasion": ["casual", "summer"],
    "season": ["summer"],
    "mood": ["refreshing", "energetic"],
    "image_url": "tom_collins.png",
    "color": "#FFFFE0",
    "origin": "New York, USA",
    "year_created": 1876,
    "source": "IBA Official",
