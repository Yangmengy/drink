  {
    "id": "cocktail-gin-09",
    "name_zh": "亡者复苏二号",
    "name_en": "Corpse Reviver No. 2",
    "category": "Gin",
    "tags": ["Contemporary Classics", "酸甜", "苦艾香"],
    "description": "四大等份原料带来绝对的平衡，淡淡的苦艾酒香气穿梭其中，有着让人瞬间清醒的魔力。",
    "story": "来自萨伏伊酒店的哈里·克拉多克（Harry Craddock）。他在酒谱中写道：“要在上午11点前饮用，否则这杯酒将不会让你复活，而是再次让你成为亡者。”它最初被设计为解酒饮料。",
    "ingredients": [
      { "name_zh": "金酒", "name_en": "Gin", "amount": 22.5, "unit": "ml", "is_optional": false },
      { "name_zh": "君度", "name_en": "Cointreau", "amount": 22.5, "unit": "ml", "is_optional": false },
      { "name_zh": "莉兰白开胃酒", "name_en": "Lillet Blanc", "amount": 22.5, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜柠檬汁", "name_en": "Lemon Juice", "amount": 22.5, "unit": "ml", "is_optional": false },
      { "name_zh": "苦艾酒", "name_en": "Absinthe", "amount": 1, "unit": "dash", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在碟形杯中滴入少许苦艾酒，转动酒杯让内壁均匀沾上苦艾酒，倒出多余部分（洗杯）。" },
      { "step_number": 2, "instruction": "将剩余的四种原料倒入摇酒壶，加冰摇匀。" },
      { "step_number": 3, "instruction": "过滤至洗好杯的冰镇碟形杯中。" },
      { "step_number": 4, "instruction": "无须额外装饰（或用橘皮卷装饰）。" }
    ],
    "method": "shake",
    "glass_type": "coupe",
    "ice_type": "none",
    "garnish": "无或橘皮",
    "difficulty": 3,
    "abv": 25.0,
    "prep_time": 4,
    "flavor_profile": { "sweet": 2, "sour": 3, "bitter": 2, "strong": 3 },
    "occasion": ["morning", "brunch", "bar"],
    "season": ["autumn", "winter"],
    "mood": ["reviving", "complex"],
    "image_url": "corpse_reviver.png",
    "color": "#F0E68C",
    "origin": "London, UK",
    "year_created": 1930,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-gin-10",
    "name_zh": "三叶草俱乐部",
    "name_en": "Clover Club",
    "category": "Gin",
