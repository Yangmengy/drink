    "is_iba": true
  },
  {
    "id": "cocktail-whiskey-03",
    "name_zh": "威士忌酸",
    "name_en": "Whiskey Sour",
    "category": "Whiskey",
    "tags": ["The Unforgettables", "酸甜", "绵密"],
    "description": "波本威士忌的焦糖香与柠檬的清爽酸味完美平衡，加入蛋清带来如丝绸般顺滑的泡沫口感。",
    "story": "Sour（酸酒）是鸡尾酒中最古老、最重要的家族之一，水手们将烈酒与柠檬汁混合以防止坏血病。1870年的一份报纸首次刊登了威士忌酸的名字，它成为了世界上最受欢迎的波本饮品。",
    "ingredients": [
      { "name_zh": "波本威士忌", "name_en": "Bourbon Whiskey", "amount": 45, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜柠檬汁", "name_en": "Lemon Juice", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "单糖浆", "name_en": "Simple Syrup", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "蛋清", "name_en": "Egg White", "amount": 15, "unit": "ml", "is_optional": true },
      { "name_zh": "安哥斯图拉苦精", "name_en": "Angostura Bitters", "amount": 1, "unit": "dash", "is_optional": true }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将威士忌、柠檬汁、糖浆和蛋清倒入摇酒壶（不加冰）。" },
      { "step_number": 2, "instruction": "干摇（Dry Shake）10秒打发蛋清。" },
      { "step_number": 3, "instruction": "加入冰块，再次大力摇晃（Wet Shake）。" },
      { "step_number": 4, "instruction": "双重过滤至放有老冰的古典杯或冰镇碟形杯中。" },
      { "step_number": 5, "instruction": "在泡沫表面滴几滴苦精，用樱桃或柠檬片装饰。" }
    ],
    "method": "shake",
    "glass_type": "old-fashioned",
    "ice_type": "cubed",
    "garnish": "半片橙子与樱桃，或苦精点缀",
    "difficulty": 3,
    "abv": 16.0,
    "prep_time": 4,
    "flavor_profile": { "sweet": 3, "sour": 4, "bitter": 1, "strong": 3 },
    "occasion": ["dinner", "bar", "party"],
    "season": ["autumn", "spring", "summer"],
    "mood": ["smooth", "comforting"],
    "image_url": "whiskey_sour.png",
    "color": "#F4A460",
    "origin": "USA",
    "year_created": 1870,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-whiskey-04",
    "name_zh": "薄荷朱丽普",
    "name_en": "Mint Julep",
    "category": "Whiskey",
    "tags": ["Contemporary Classics", "薄荷", "清凉", "夏日"],
    "description": "波本威士忌与新鲜薄荷的极致清凉碰撞，盛装在结满冰霜的银杯中，是美国南部的象征。",
    "story": "Julep这个词源于阿拉伯语“gulab”（玫瑰水）。它最初是一种用薄荷掩盖劣质烈酒味道的饮品，后来在1938年成为肯塔基打吡赛马会（Kentucky Derby）的官方饮品，每年比赛期间要消耗超过12万杯。",
    "ingredients": [
      { "name_zh": "波本威士忌", "name_en": "Bourbon Whiskey", "amount": 60, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜薄荷叶", "name_en": "Fresh Mint Leaves", "amount": 8, "unit": "片", "is_optional": false },
      { "name_zh": "单糖浆", "name_en": "Simple Syrup", "amount": 10, "unit": "ml", "is_optional": false },
      { "name_zh": "水", "name_en": "Water", "amount": 5, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在银制朱丽普杯（Julep Cup）或古典杯中放入薄荷叶、糖浆和少许水。" },
      { "step_number": 2, "instruction": "用捣棒极其轻柔地压榨薄荷，释放香气（切勿捣碎，否则会发苦）。" },
      { "step_number": 3, "instruction": "加满碎冰，倒入波本威士忌。" },
      { "step_number": 4, "instruction": "用吧勺上下提拉搅拌，直到杯壁结上一层厚厚的白霜。" },
      { "step_number": 5, "instruction": "在顶部再铺满一层碎冰，插上一株极其丰满的薄荷枝作为装饰。" }
    ],
    "method": "muddle",
    "glass_type": "julep",
    "ice_type": "crushed",
    "garnish": "一簇新鲜薄荷枝",
    "difficulty": 3,
    "abv": 24.0,
    "prep_time": 4,
    "flavor_profile": { "sweet": 2, "sour": 0, "bitter": 1, "strong": 4 },
    "occasion": ["summer", "derby", "party"],
    "season": ["summer", "spring"],
    "mood": ["refreshing", "southern"],
    "image_url": "mint_julep.png",
    "color": "#D2B48C",
    "origin": "Kentucky, USA",
    "year_created": 1800,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-whiskey-05",
    "name_zh": "花花公子",
    "name_en": "Boulevardier",
    "category": "Whiskey",
    "tags": ["Contemporary Classics", "苦甜", "深邃"],
    "description": "尼格罗尼的波本威士忌变体，但更温暖、浓郁，充满了深沉的木质香与复杂的苦甜交织。",
    "story": "诞生于1920年代的巴黎，由《花花公子》（Boulevardier）杂志的创办人Erskine Gwynne（一位移居巴黎的美国作家）发明。他将美国人钟爱的波本与欧洲传统的苦味酒结合，成就了这杯经典。",
    "ingredients": [
      { "name_zh": "波本或黑麦威士忌", "name_en": "Bourbon or Rye Whiskey", "amount": 45, "unit": "ml", "is_optional": false },
      { "name_zh": "金巴利", "name_en": "Campari", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "甜味美思", "name_en": "Sweet Red Vermouth", "amount": 30, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在古典杯中放入一块大老冰。" },
      { "step_number": 2, "instruction": "依次倒入威士忌、金巴利和甜味美思。" },
      { "step_number": 3, "instruction": "用吧勺轻轻搅拌20秒。" },
      { "step_number": 4, "instruction": "捏出橙皮精油后，投入杯中作为装饰。" }
    ],
    "method": "build",
    "glass_type": "old-fashioned",
    "ice_type": "block",
    "garnish": "橙皮",
    "difficulty": 2,
    "abv": 26.0,
    "prep_time": 2,
    "flavor_profile": { "sweet": 3, "sour": 0, "bitter": 4, "strong": 4 },
    "occasion": ["dinner", "bar"],
    "season": ["autumn", "winter"],
    "mood": ["sophisticated", "warm"],
    "image_url": "boulevardier.png",
