  },
  {
    "id": "cocktail-whiskey-06",
    "name_zh": "萨泽拉克",
    "name_en": "Sazerac",
    "category": "Whiskey",
    "tags": ["The Unforgettables", "茴香", "强劲"],
    "description": "新奥尔良的官方鸡尾酒。杯壁那抹若有若无的苦艾酒香气，与黑麦威士忌的辛辣完美融合。",
    "story": "世界上最古老的鸡尾酒之一，诞生于19世纪中叶的新奥尔良。最初使用法国干邑（Sazerac de Forge et Fils）调制，后来由于葡萄芽瘤蚜虫害导致干邑短缺，便改用美国本土的黑麦威士忌，并加入了当地特有的Peychaud's苦精。",
    "ingredients": [
      { "name_zh": "干邑白兰地或黑麦威士忌", "name_en": "Cognac or Rye Whiskey", "amount": 50, "unit": "ml", "is_optional": false },
      { "name_zh": "苦艾酒", "name_en": "Absinthe", "amount": 10, "unit": "ml", "is_optional": false },
      { "name_zh": "方糖", "name_en": "Sugar Cube", "amount": 1, "unit": "块", "is_optional": false },
      { "name_zh": "裴乔氏苦精", "name_en": "Peychaud's Bitters", "amount": 2, "unit": "dash", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在一个古典杯中加满碎冰使其彻底冰镇。" },
      { "step_number": 2, "instruction": "在调酒杯中放入方糖，滴入裴乔氏苦精和少许水捣碎。" },
      { "step_number": 3, "instruction": "在调酒杯中加入冰块和威士忌，搅拌冷却。" },
      { "step_number": 4, "instruction": "倒掉古典杯中的碎冰，倒入苦艾酒转动洗杯后倒出多余部分。" },
      { "step_number": 5, "instruction": "将调酒杯中的酒液滤入洗过杯的古典杯中。" },
      { "step_number": 6, "instruction": "捏出柠檬皮精油，但不将皮扔进杯中（传统做法）。" }
    ],
    "method": "stir",
    "glass_type": "old-fashioned",
    "ice_type": "none",
    "garnish": "柠檬皮精油（不留皮）",
    "difficulty": 4,
    "abv": 35.0,
    "prep_time": 4,
    "flavor_profile": { "sweet": 2, "sour": 0, "bitter": 3, "strong": 5 },
    "occasion": ["dinner", "bar", "cigar"],
    "season": ["autumn", "winter"],
    "mood": ["historic", "bold"],
    "image_url": "sazerac.png",
    "color": "#CD853F",
    "origin": "New Orleans, USA",
    "year_created": 1850,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-whiskey-07",
    "name_zh": "爱尔兰咖啡",
    "name_en": "Irish Coffee",
    "category": "Whiskey",
    "tags": ["Contemporary Classics", "热饮", "咖啡", "温暖"],
    "description": "热咖啡的香浓、爱尔兰威士忌的烈性与鲜奶油的冰凉绵密在口中交融，是寒冬最暖心的安慰。",
    "story": "1943年，在爱尔兰福因斯港（Foynes Port），一架飞往纽约的泛美航空水上飞机因恶劣天气折返。餐厅主厨Joe Sheridan为了给冻坏的乘客驱寒，在他们的热咖啡里加入了爱尔兰威士忌，并盖上奶油。当乘客问这是否是巴西咖啡时，他回答：“这是爱尔兰咖啡。”",
    "ingredients": [
      { "name_zh": "爱尔兰威士忌", "name_en": "Irish Whiskey", "amount": 50, "unit": "ml", "is_optional": false },
      { "name_zh": "热咖啡", "name_en": "Hot Coffee", "amount": 120, "unit": "ml", "is_optional": false },
      { "name_zh": "鲜奶油", "name_en": "Fresh Cream", "amount": 50, "unit": "ml", "is_optional": false },
      { "name_zh": "红糖", "name_en": "Brown Sugar", "amount": 1, "unit": "吧勺", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "用热水温热爱尔兰咖啡杯。" },
      { "step_number": 2, "instruction": "倒入热咖啡，加入红糖搅拌至溶解。" },
      { "step_number": 3, "instruction": "倒入爱尔兰威士忌并混合均匀。" },
      { "step_number": 4, "instruction": "将轻轻打发（微稠但不成硬块）的鲜奶油顺着吧勺背面缓缓倒入，使其漂浮在酒液表面。" },
      { "step_number": 5, "instruction": "不要搅拌，直接透过冰凉的奶油饮用底部的热咖啡。" }
    ],
    "method": "build",
    "glass_type": "irish-coffee",
    "ice_type": "none",
    "garnish": "无",
    "difficulty": 3,
    "abv": 14.0,
    "prep_time": 5,
    "flavor_profile": { "sweet": 3, "sour": 0, "bitter": 3, "strong": 3 },
    "occasion": ["winter", "afternoon", "comfort"],
    "season": ["winter"],
    "mood": ["warm", "comforting"],
    "image_url": "irish_coffee.png",
    "color": "#3E2723",
    "origin": "Ireland",
    "year_created": 1943,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-whiskey-08",
    "name_zh": "盘尼西林",
    "name_en": "Penicillin",
    "category": "Whiskey",
    "tags": ["New Era Drinks", "泥煤", "生姜", "现代经典"],
    "description": "21世纪最伟大的现代经典。生姜的辛辣、蜂蜜的滋润与艾雷岛威士忌那迷人的泥煤消毒水味，堪称绝妙的治愈灵药。",
    "story": "由纽约Milk & Honey酒吧的明星调酒师Sam Ross于2005年创造。名字来源于它的成分：蜂蜜、柠檬和生姜就像是对抗感冒的良药，而漂浮在顶部那一层重泥煤威士忌的气味则像极了医院里的消毒水，这杯“抗生素”因此得名。",
    "ingredients": [
      { "name_zh": "苏格兰调和威士忌", "name_en": "Blended Scotch Whisky", "amount": 60, "unit": "ml", "is_optional": false },
      { "name_zh": "艾雷岛单一麦芽威士忌", "name_en": "Islay Single Malt Scotch", "amount": 7.5, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜柠檬汁", "name_en": "Lemon Juice", "amount": 22.5, "unit": "ml", "is_optional": false },
      { "name_zh": "蜂蜜糖浆", "name_en": "Honey Syrup", "amount": 22.5, "unit": "ml", "is_optional": false },
      { "name_zh": "鲜榨生姜汁", "name_en": "Fresh Ginger Juice", "amount": 2, "unit": "吧勺", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将调和威士忌、柠檬汁、蜂蜜糖浆和生姜汁倒入摇酒壶。" },
      { "step_number": 2, "instruction": "加入冰块，用力摇匀。" },
      { "step_number": 3, "instruction": "过滤至装有大块老冰的古典杯中。" },
      { "step_number": 4, "instruction": "将艾雷岛重泥煤威士忌轻轻倒在表面（Float）。" },
      { "step_number": 5, "instruction": "用糖渍姜片作为装饰。" }
    ],
    "method": "shake",
    "glass_type": "old-fashioned",
    "ice_type": "block",
    "garnish": "糖渍姜片",
    "difficulty": 4,
    "abv": 20.0,
    "prep_time": 5,
    "flavor_profile": { "sweet": 3, "sour": 3, "bitter": 1, "strong": 4 },
    "occasion": ["bar", "winter"],
    "season": ["autumn", "winter"],
    "mood": ["healing", "smoky"],
    "image_url": "penicillin.png",
    "color": "#DAA520",
