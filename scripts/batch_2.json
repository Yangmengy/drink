[
  {
    "id": "cocktail-whiskey-01",
    "name_zh": "老式",
    "name_en": "Old Fashioned",
    "category": "Whiskey",
    "tags": ["The Unforgettables", "经典", "浓烈"],
    "description": "最初的“鸡尾酒”定义本身。威士忌、糖、水和苦精的纯粹组合，尽显烈酒本色。",
    "story": "在19世纪初，只要包含烈酒、糖、水和苦精的饮料都被称为鸡尾酒。随着后来调酒手法变得花哨，一些酒客要求酒保按照“老派的方式”（Old Fashioned way）调酒，这款经典便由此得名。",
    "ingredients": [
      { "name_zh": "波本威士忌或黑麦威士忌", "name_en": "Bourbon or Rye Whiskey", "amount": 45, "unit": "ml", "is_optional": false },
      { "name_zh": "方糖", "name_en": "Sugar Cube", "amount": 1, "unit": "块", "is_optional": false },
      { "name_zh": "安哥斯图拉苦精", "name_en": "Angostura Bitters", "amount": 2, "unit": "dash", "is_optional": false },
      { "name_zh": "水", "name_en": "Water", "amount": 1, "unit": "dash", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在古典杯中放入方糖，滴入苦精和少许水。" },
      { "step_number": 2, "instruction": "用捣棒（Muddler）将方糖捣碎至溶解。" },
      { "step_number": 3, "instruction": "加满大块老冰，倒入威士忌。" },
      { "step_number": 4, "instruction": "轻轻搅拌均匀，喷洒橙皮精油并投入杯中装饰。" }
    ],
    "method": "build",
    "glass_type": "old-fashioned",
    "ice_type": "block",
    "garnish": "橙皮或樱桃",
    "difficulty": 2,
    "abv": 32.0,
    "prep_time": 3,
    "flavor_profile": { "sweet": 2, "sour": 0, "bitter": 3, "strong": 5 },
    "occasion": ["dinner", "cigar", "relaxing"],
    "season": ["autumn", "winter"],
    "mood": ["classic", "contemplative"],
    "image_url": "old_fashioned.png",
    "color": "#D2691E",
