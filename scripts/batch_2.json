  {
    "id": "cocktail-whiskey-02",
    "name_zh": "曼哈顿",
    "name_en": "Manhattan",
    "category": "Whiskey",
    "tags": ["The Unforgettables", "深邃", "餐后"],
    "description": "鸡尾酒王后。黑麦威士忌的辛辣与甜味美思的草本甜香完美交织，有着高贵的女王气质。",
    "story": "传说中它是在1870年代纽约的曼哈顿俱乐部（Manhattan Club）为温斯顿·丘吉尔的母亲珍妮·杰罗姆（Jennie Jerome）举办的一场宴会上诞生的。它是第一批使用味美思作为调味品的鸡尾酒之一。",
    "ingredients": [
      { "name_zh": "黑麦威士忌", "name_en": "Rye Whiskey", "amount": 50, "unit": "ml", "is_optional": false },
      { "name_zh": "甜味美思", "name_en": "Sweet Red Vermouth", "amount": 20, "unit": "ml", "is_optional": false },
      { "name_zh": "安哥斯图拉苦精", "name_en": "Angostura Bitters", "amount": 1, "unit": "dash", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将所有原料倒入调酒杯中。" },
      { "step_number": 2, "instruction": "加入大量冰块，用吧勺搅拌均匀至充分冷却。" },
      { "step_number": 3, "instruction": "滤入冰镇的碟形杯或马天尼杯中。" },
      { "step_number": 4, "instruction": "以一颗马拉斯奇诺樱桃作为装饰。" }
    ],
    "method": "stir",
    "glass_type": "coupe",
    "ice_type": "none",
    "garnish": "马拉斯奇诺樱桃",
    "difficulty": 2,
    "abv": 28.0,
    "prep_time": 2,
    "flavor_profile": { "sweet": 3, "sour": 0, "bitter": 2, "strong": 4 },
    "occasion": ["dinner", "bar"],
    "season": ["autumn", "winter"],
    "mood": ["sophisticated", "elegant"],
    "image_url": "manhattan.png",
    "color": "#8B0000",
    "origin": "New York, USA",
    "year_created": 1870,
