  {
    "id": "cocktail-vodka-07",
    "name_zh": "维斯帕",
    "name_en": "Vesper",
    "category": "Vodka",
    "tags": ["Contemporary Classics", "詹姆斯邦德", "金酒与伏特加"],
    "description": "唯一一款同时使用金酒和伏特加作为基酒的经典马天尼变体。以开胃酒丽莱白（Lillet Blanc）代替干味美思，强劲而优雅。",
    "story": "在伊恩·弗莱明1953年的小说《皇家赌场》中，詹姆斯·邦德亲口向酒保报出了这款酒的配方，并以他深爱的双面女间谍 Vesper Lynd 的名字命名。“Shaken, not stirred”（摇匀，不要搅拌）的经典台词由此发扬光大。",
    "ingredients": [
      { "name_zh": "金酒", "name_en": "Gin", "amount": 45, "unit": "ml", "is_optional": false },
      { "name_zh": "伏特加", "name_en": "Vodka", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "丽莱白 (Lillet Blanc) / Cocchi Americano", "name_en": "Lillet Blanc", "amount": 7.5, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "按照邦德的指示，将所有液体倒入摇酒壶中（现代调酒师更倾向于搅拌）。" },
      { "step_number": 2, "instruction": "加入大量冰块，剧烈摇晃至冰冷刺骨。" },
      { "step_number": 3, "instruction": "过滤至冰镇好的高脚马天尼杯中。" },
      { "step_number": 4, "instruction": "切一大片细长的柠檬皮，挤压出精油后投入杯中。" }
    ],
    "method": "shake",
    "glass_type": "martini",
    "ice_type": "none",
    "garnish": "长条柠檬皮卷",
    "difficulty": 2,
    "abv": 34.0,
    "prep_time": 3,
    "flavor_profile": { "sweet": 1, "sour": 0, "bitter": 2, "strong": 5 },
    "occasion": ["dinner", "casino", "bar"],
    "season": ["all"],
    "mood": ["suave", "dangerous"],
    "image_url": "vesper.png",
    "color": "#FDF5E6",
    "origin": "London, UK",
    "year_created": 1953,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-vodka-08",
    "name_zh": "海风",
    "name_en": "Sea Breeze",
    "category": "Vodka",
    "tags": ["Contemporary Classics", "果味", "长饮", "蔓越莓"],
    "description": "蔓越莓的酸甜与西柚的微苦完美中和了伏特加的酒精感，如夏日海滩上的微风般清爽宜人。",
    "story": "诞生于1920年代，最初使用的是杜松子酒和石榴糖浆。到了1970年代，由于蔓越莓生产商的大力营销，改用了伏特加与蔓越莓汁的组合，从而在炎热的夏季海滩酒吧里大受欢迎。",
    "ingredients": [
      { "name_zh": "伏特加", "name_en": "Vodka", "amount": 40, "unit": "ml", "is_optional": false },
      { "name_zh": "蔓越莓汁", "name_en": "Cranberry Juice", "amount": 120, "unit": "ml", "is_optional": false },
      { "name_zh": "西柚汁", "name_en": "Grapefruit Juice", "amount": 30, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在高筒杯中装满冰块。" },
      { "step_number": 2, "instruction": "倒入伏特加、蔓越莓汁和西柚汁。" },
      { "step_number": 3, "instruction": "用吧勺轻轻搅拌均匀。" },
      { "step_number": 4, "instruction": "用一片西柚或青柠角装饰。" }
    ],
    "method": "build",
    "glass_type": "highball",
    "ice_type": "cubed",
    "garnish": "西柚片",
    "difficulty": 1,
    "abv": 9.0,
    "prep_time": 2,
    "flavor_profile": { "sweet": 3, "sour": 3, "bitter": 1, "strong": 1 },
    "occasion": ["beach", "afternoon", "casual"],
    "season": ["summer"],
    "mood": ["breezy", "refreshing"],
    "image_url": "sea_breeze.png",
    "color": "#FA8072",
    "origin": "USA",
    "year_created": 1920,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-vodka-09",
    "name_zh": "柠檬滴",
    "name_en": "Lemon Drop",
    "category": "Vodka",
    "tags": ["New Era Drinks", "糖边", "酸甜", "柑橘"],
    "description": "犹如液体的酸甜柠檬糖果。杯口的糖霜中和了柠檬的酸涩，是一款极易入口的现代经典短饮。",
    "story": "由旧金山 Henry Africa 酒吧的老板 Norman Jay Hobday 在1970年代发明。这家酒吧被认为是美国第一家“蕨类酒吧”(Fern Bar)，致力于创造针对女性顾客的香甜果味鸡尾酒，柠檬滴是其中最成功的代表作。",
    "ingredients": [
      { "name_zh": "柑橘伏特加", "name_en": "Citrus Vodka", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "三倍橙酒 (Triple Sec)", "name_en": "Triple Sec", "amount": 20, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜柠檬汁", "name_en": "Lemon Juice", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "单糖浆", "name_en": "Simple Syrup", "amount": 15, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "用柠檬角擦拭马天尼杯的边缘，然后蘸上一圈白砂糖（糖边）。" },
      { "step_number": 2, "instruction": "将所有原料倒入摇酒壶。" },
      { "step_number": 3, "instruction": "加入冰块，剧烈摇晃以充分冷却并产生微小冰晶。" },
      { "step_number": 4, "instruction": "过滤至准备好糖边的杯中，用柠檬皮点缀。" }
    ],
    "method": "shake",
    "glass_type": "martini",
    "ice_type": "none",
    "garnish": "糖边与柠檬皮",
    "difficulty": 2,
    "abv": 20.0,
    "prep_time": 3,
    "flavor_profile": { "sweet": 4, "sour": 4, "bitter": 0, "strong": 3 },
    "occasion": ["party", "bar"],
    "season": ["summer", "spring"],
    "mood": ["playful", "sweet"],
    "image_url": "lemon_drop.png",
    "color": "#FFFACD",
    "origin": "San Francisco, USA",
