    ],
    "steps": [
      { "step_number": 1, "instruction": "在古典杯中装满大冰块。" },
      { "step_number": 2, "instruction": "倒入伏特加和咖啡利口酒。" },
      { "step_number": 3, "instruction": "用吧勺轻轻搅拌冷却并稀释即可。" }
    ],
    "method": "build",
    "glass_type": "old-fashioned",
    "ice_type": "cubed",
    "garnish": "无或樱桃",
    "difficulty": 1,
    "abv": 28.0,
    "prep_time": 1,
    "flavor_profile": { "sweet": 3, "sour": 0, "bitter": 2, "strong": 4 },
    "occasion": ["after dinner", "bar"],
    "season": ["winter", "autumn"],
    "mood": ["dark", "mysterious"],
    "image_url": "black_russian.png",
