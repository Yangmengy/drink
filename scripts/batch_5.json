[
  {
    "id": "cocktail-vodka-01",
    "name_zh": "莫斯科骡子",
    "name_en": "Moscow Mule",
    "category": "Vodka",
    "tags": ["Contemporary Classics", "姜汁啤酒", "铜杯"],
    "description": "标志性的铜马克杯中，伏特加的纯净被姜汁啤酒的辛辣和青柠的酸涩点燃，极致清凉解渴。",
    "story": "1941年诞生于曼哈顿。当时斯米诺伏特加的老板、一家姜汁啤酒厂的老板以及一家铜器厂的继承人都在为各自滞销的产品发愁，三人一拍即合，创造了这款放在铜杯里的爆款饮料，彻底打开了伏特加在美国的市场。",
    "ingredients": [
      { "name_zh": "伏特加", "name_en": "Vodka", "amount": 45, "unit": "ml", "is_optional": false },
      { "name_zh": "姜汁啤酒", "name_en": "Ginger Beer", "amount": 120, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜青柠汁", "name_en": "Lime Juice", "amount": 10, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在铜制马克杯或高球杯中加满冰块。" },
      { "step_number": 2, "instruction": "倒入伏特加和青柠汁。" },
      { "step_number": 3, "instruction": "加满姜汁啤酒。" },
      { "step_number": 4, "instruction": "用青柠角和薄荷叶进行装饰。" }
    ],
    "method": "build",
    "glass_type": "highball",
    "ice_type": "cubed",
    "garnish": "青柠角与薄荷",
    "difficulty": 1,
    "abv": 10.0,
    "prep_time": 2,
    "flavor_profile": { "sweet": 2, "sour": 2, "bitter": 1, "strong": 2 },
    "occasion": ["party", "casual", "summer"],
    "season": ["summer", "autumn"],
    "mood": ["refreshing", "spicy"],
    "image_url": "moscow_mule.png",
    "color": "#FDF5E6",
    "origin": "New York, USA",
    "year_created": 1941,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-vodka-02",
    "name_zh": "大都会",
    "name_en": "Cosmopolitan",
    "category": "Vodka",
    "tags": ["Contemporary Classics", "蔓越莓", "时尚"],
    "description": "呈诱人的粉红色，蔓越莓的微酸与柑橘伏特加的香气完美结合，是都市时尚与优雅的代名词。",
    "story": "在1990年代末期因为热门美剧《欲望都市》(Sex and the City) 中女主角Carrie的偏爱而风靡全球。它的现代配方通常被认为是1980年代由调酒师Toby Cecchini在纽约的Odeon酒吧确立的。",
    "ingredients": [
      { "name_zh": "柠檬/柑橘伏特加", "name_en": "Citrus Vodka", "amount": 40, "unit": "ml", "is_optional": false },
      { "name_zh": "君度 (Cointreau)", "name_en": "Cointreau", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜青柠汁", "name_en": "Lime Juice", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "蔓越莓汁", "name_en": "Cranberry Juice", "amount": 30, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将所有原料倒入摇酒壶中。" },
      { "step_number": 2, "instruction": "加入大量冰块，用力摇晃至极其冰冷。" },
      { "step_number": 3, "instruction": "双重过滤至冰镇的马天尼杯中。" },
      { "step_number": 4, "instruction": "在杯口上方挤压点燃一片橙皮（Flared Orange Peel），然后将其投入杯中作为装饰。" }
    ],
    "method": "shake",
    "glass_type": "martini",
    "ice_type": "none",
    "garnish": "点燃的橙皮卷",
    "difficulty": 2,
    "abv": 22.0,
    "prep_time": 3,
    "flavor_profile": { "sweet": 2, "sour": 3, "bitter": 1, "strong": 3 },
    "occasion": ["party", "night out"],
    "season": ["all"],
    "mood": ["chic", "glamorous"],
    "image_url": "cosmopolitan.png",
    "color": "#FF69B4",
    "origin": "New York, USA",
    "year_created": 1987,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-vodka-03",
    "name_zh": "血腥玛丽",
    "name_en": "Bloody Mary",
    "category": "Vodka",
    "tags": ["Contemporary Classics", "番茄", "咸鲜", "解酒"],
    "description": "世界上最著名的解酒饮料（Hair of the Dog）。浓郁的番茄汁中加入了黑胡椒、芹菜盐、塔巴斯科辣酱等丰富的香料，像一碗冰镇的冷汤。",
    "story": "传说是在1920年代的巴黎哈里纽约酒吧（Harry's New York Bar）由调酒师 Fernand Petiot 发明，后来他到了纽约瑞吉酒店后加入了辣椒酱和柠檬汁，使其声名大噪。名字常被认为与十六世纪英国女王玛丽一世有关。",
    "ingredients": [
      { "name_zh": "伏特加", "name_en": "Vodka", "amount": 45, "unit": "ml", "is_optional": false },
      { "name_zh": "番茄汁", "name_en": "Tomato Juice", "amount": 90, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜柠檬汁", "name_en": "Lemon Juice", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "伍斯特酱 (喼汁)", "name_en": "Worcestershire Sauce", "amount": 3, "unit": "dash", "is_optional": false },
      { "name_zh": "塔巴斯科辣酱", "name_en": "Tabasco", "amount": 2, "unit": "dash", "is_optional": false },
      { "name_zh": "芹菜盐与黑胡椒", "name_en": "Celery Salt & Pepper", "amount": 1, "unit": "pinch", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将所有原料倒入装有冰块的摇酒壶中。" },
      { "step_number": 2, "instruction": "不要剧烈摇晃，而是使用“Rolling”（在两个摇酒壶之间来回倾倒）的方式混合，以避免番茄汁起泡。" },
      { "step_number": 3, "instruction": "倒入高筒杯中。" },
      { "step_number": 4, "instruction": "用一根西芹梗和柠檬角作为装饰。" }
    ],
    "method": "rolling",
    "glass_type": "highball",
    "ice_type": "cubed",
    "garnish": "西芹梗与柠檬角",
    "difficulty": 3,
    "abv": 10.0,
    "prep_time": 4,
    "flavor_profile": { "sweet": 1, "sour": 3, "bitter": 1, "strong": 2 },
    "occasion": ["brunch", "morning", "hangover"],
    "season": ["all"],
    "mood": ["savory", "reviving"],
    "image_url": "bloody_mary.png",
    "color": "#8B0000",
    "origin": "Paris, France",
    "year_created": 1921,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-vodka-04",
    "name_zh": "浓缩咖啡马天尼",
    "name_en": "Espresso Martini",
    "category": "Vodka",
    "tags": ["New Era Drinks", "咖啡", "提神", "现代"],
    "description": "完美的夜生活启动器。冷萃浓缩咖啡的苦韵与咖啡利口酒的香甜交织，摇晃后表面会形成一层细腻的咖啡油脂（Crema）。",
    "story": "由已故的伦敦调酒大师 Dick Bradsell 于1980年代发明。据说当时一位著名的年轻女模特走进酒吧，要求一杯能够“Wake me up, and then fuck me up”（让我清醒，然后再把我灌醉）的酒，于是这杯现代经典诞生了。",
    "ingredients": [
      { "name_zh": "伏特加", "name_en": "Vodka", "amount": 50, "unit": "ml", "is_optional": false },
      { "name_zh": "咖啡利口酒 (如Kahlúa)", "name_en": "Coffee Liqueur", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "现萃浓缩咖啡", "name_en": "Espresso (hot)", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "单糖浆", "name_en": "Simple Syrup", "amount": 10, "unit": "ml", "is_optional": true }
    ],
    "steps": [
      { "step_number": 1, "instruction": "萃取一份高质量的浓缩咖啡。" },
      { "step_number": 2, "instruction": "将热咖啡与其他液体原料一起倒入摇酒壶。" },
      { "step_number": 3, "instruction": "加入大量冰块，非常剧烈地摇晃，以产生绵密的咖啡泡沫。" },
      { "step_number": 4, "instruction": "快速过滤至冰镇的马天尼或碟形杯中。" },
      { "step_number": 5, "instruction": "在泡沫表面放上三颗咖啡豆作为装饰（象征健康、财富和幸福）。" }
    ],
    "method": "shake",
    "glass_type": "martini",
    "ice_type": "none",
    "garnish": "三颗咖啡豆",
    "difficulty": 3,
    "abv": 20.0,
    "prep_time": 4,
    "flavor_profile": { "sweet": 3, "sour": 1, "bitter": 3, "strong": 3 },
    "occasion": ["after dinner", "night out"],
    "season": ["all"],
    "mood": ["energetic", "sophisticated"],
    "image_url": "espresso_martini.png",
    "color": "#2C1E16",
    "origin": "London, UK",
    "year_created": 1983,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-vodka-05",
    "name_zh": "白俄罗斯",
    "name_en": "White Russian",
    "category": "Vodka",
    "tags": ["Classic", "奶油", "咖啡", "甜点"],
    "description": "像是一杯带酒精的冰镇拿铁。厚重的鲜奶油漂浮在伏特加与咖啡酒之上，口感丝滑，极度香甜舒适。",
    "story": "黑俄罗斯（Black Russian）的变体，加入了鲜奶油。虽然名字里有“俄罗斯”，但其实诞生于比利时。不过真正让它声名大噪的是1998年的邪典电影《谋杀绿脚趾》(The Big Lebowski)，片中主角“督爷”(The Dude) 几乎全程都在喝这款酒。",
    "ingredients": [
      { "name_zh": "伏特加", "name_en": "Vodka", "amount": 50, "unit": "ml", "is_optional": false },
      { "name_zh": "咖啡利口酒", "name_en": "Coffee Liqueur", "amount": 20, "unit": "ml", "is_optional": false },
      { "name_zh": "鲜奶油 (Heavy Cream)", "name_en": "Fresh Cream", "amount": 30, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在古典杯中加满冰块。" },
      { "step_number": 2, "instruction": "倒入伏特加和咖啡利口酒，轻轻搅拌。" },
      { "step_number": 3, "instruction": "将鲜奶油顺着吧勺背面轻轻倒在表面，形成一层白色的漂浮层。" },
      { "step_number": 4, "instruction": "不要搅拌，直接饮用（或随客人喜好自行搅拌）。" }
    ],
    "method": "build",
    "glass_type": "old-fashioned",
    "ice_type": "cubed",
    "garnish": "无或肉豆蔻粉",
    "difficulty": 1,
    "abv": 18.0,
    "prep_time": 2,
    "flavor_profile": { "sweet": 4, "sour": 0, "bitter": 2, "strong": 3 },
    "occasion": ["after dinner", "casual"],
    "season": ["winter", "autumn"],
    "mood": ["relaxed", "cozy"],
    "image_url": "white_russian.png",
    "color": "#F5DEB3",
    "origin": "Brussels, Belgium",
    "year_created": 1949,
    "source": "Classic",
    "is_iba": false
  },
  {
    "id": "cocktail-vodka-06",
    "name_zh": "黑俄罗斯",
    "name_en": "Black Russian",
    "category": "Vodka",
    "tags": ["Contemporary Classics", "咖啡", "烈酒", "极简"],
    "description": "极简主义的典范。去除了白俄罗斯的奶油，只有纯粹的伏特加冷酷与咖啡利口酒的深沉甜苦，暗黑而迷人。",
    "story": "由比利时布鲁塞尔大都会酒店的调酒师 Gustave Tops 为当时美国驻卢森堡的大使 Perle Mesta 女士创作。因为正值冷战时期，便用“黑”字加上代表伏特加的“俄罗斯”来命名这款神秘深邃的酒。",
    "ingredients": [
      { "name_zh": "伏特加", "name_en": "Vodka", "amount": 50, "unit": "ml", "is_optional": false },
