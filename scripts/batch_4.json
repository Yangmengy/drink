    "name_en": "Batanga",
    "category": "Tequila",
    "tags": ["Mexico", "可乐", "长饮"],
    "description": "古巴自由的墨西哥表亲。龙舌兰与可乐的奇妙结合，粗海盐边是不可或缺的灵魂。",
    "story": "由传奇调酒师 Don Javier Delgado Corona 在其位于特基拉镇（Tequila）的 La Capilla 酒吧发明。他坚持必须用同一把切过辣椒的刀来搅拌这杯酒，以赋予它一种“无法言说”的魔力。",
    "ingredients": [
      { "name_zh": "银龙舌兰", "name_en": "Tequila Blanco", "amount": 50, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜青柠汁", "name_en": "Lime Juice", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "可乐", "name_en": "Cola", "amount": 100, "unit": "ml", "is_optional": false },
      { "name_zh": "粗海盐", "name_en": "Coarse Salt", "amount": 1, "unit": "dash", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "用青柠角在厚底高筒杯的杯口抹上一圈粗盐边。" },
      { "step_number": 2, "instruction": "在杯中装满大冰块。" },
      { "step_number": 3, "instruction": "倒入龙舌兰和青柠汁。" },
      { "step_number": 4, "instruction": "加满可乐，用吧勺（或一把刀）轻轻搅拌均匀。" }
