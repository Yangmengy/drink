  {
    "id": "cocktail-tequila-04",
    "name_zh": "汤米玛格丽特",
    "name_en": "Tommy's Margarita",
    "category": "Tequila",
    "tags": ["New Era Drinks", "龙舌兰糖浆", "纯粹"],
    "description": "新时代的玛格丽特变体，去除了三倍橙酒，改用纯正的龙舌兰糖浆作为甜味剂，让基酒的植物风味更为纯粹。",
    "story": "由旧金山 Tommy's 墨西哥餐厅的 Julio Bermejo 创造。他决定摒弃传统的橙味利口酒，转而使用龙舌兰植物本身提取的糖浆，这一改变让全球的调酒师惊为天人，从此成为现代经典。",
    "ingredients": [
      { "name_zh": "100%纯银龙舌兰", "name_en": "100% Agave Tequila", "amount": 60, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜青柠汁", "name_en": "Lime Juice", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "龙舌兰糖浆 (Agave Nectar)", "name_en": "Agave Nectar", "amount": 15, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将所有原料倒入摇酒壶中。" },
      { "step_number": 2, "instruction": "加入冰块，剧烈摇晃。" },
      { "step_number": 3, "instruction": "过滤至装有冰块的古典杯中（可选半边盐边）。" },
      { "step_number": 4, "instruction": "用青柠角装饰。" }
    ],
    "method": "shake",
    "glass_type": "old-fashioned",
    "ice_type": "cubed",
    "garnish": "青柠角",
    "difficulty": 2,
    "abv": 24.0,
    "prep_time": 3,
    "flavor_profile": { "sweet": 2, "sour": 4, "bitter": 1, "strong": 4 },
    "occasion": ["dinner", "bar"],
    "season": ["all"],
    "mood": ["authentic", "sharp"],
