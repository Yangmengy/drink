      { "name_zh": "新鲜橙汁", "name_en": "Orange Juice", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜青柠汁", "name_en": "Lime Juice", "amount": 10, "unit": "ml", "is_optional": false },
      { "name_zh": "蜂蜜", "name_en": "Honey", "amount": 1, "unit": "tsp", "is_optional": false },
