[
  {
    "id": "cocktail-tequila-01",
    "name_zh": "玛格丽特",
    "name_en": "Margarita",
    "category": "Tequila",
    "tags": ["Contemporary Classics", "酸甜", "盐边"],
    "description": "全球最著名的龙舌兰鸡尾酒。杯口的盐边完美提升了龙舌兰的植物香气与青柠的酸涩，回味无穷。",
    "story": "关于它的起源众说纷纭。最浪漫的一个版本说，它是由一位洛杉矶的酒保在1930年代创造的，为了纪念他的一位名叫Margarita的年轻女星前女友，她对其他所有烈酒都过敏，唯独能喝龙舌兰。",
    "ingredients": [
      { "name_zh": "银龙舌兰", "name_en": "Tequila Blanco", "amount": 50, "unit": "ml", "is_optional": false },
      { "name_zh": "三倍橙酒 (Triple Sec)", "name_en": "Triple Sec", "amount": 20, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜青柠汁", "name_en": "Lime Juice", "amount": 15, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "用青柠角擦拭玛格丽特杯的边缘，然后将其蘸上一圈细盐（半圈也可）。" },
      { "step_number": 2, "instruction": "将所有液体原料倒入摇酒壶。" },
      { "step_number": 3, "instruction": "加入冰块，剧烈摇晃至冷却。" },
      { "step_number": 4, "instruction": "过滤至准备好的带有盐边的杯中。" }
    ],
    "method": "shake",
    "glass_type": "margarita",
    "ice_type": "none",
    "garnish": "盐边与青柠角",
    "difficulty": 2,
    "abv": 26.0,
    "prep_time": 4,
    "flavor_profile": { "sweet": 2, "sour": 4, "bitter": 1, "strong": 3 },
    "occasion": ["party", "dinner", "summer"],
    "season": ["summer", "spring"],
    "mood": ["festive", "refreshing"],
