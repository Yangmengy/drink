  {
    "id": "cocktail-tequila-02",
    "name_zh": "龙舌兰日出",
    "name_en": "Tequila Sunrise",
    "category": "Tequila",
    "tags": ["Contemporary Classics", "果味", "分层"],
    "description": "拥有迷人的渐变色彩，宛如清晨升起的太阳，橙汁的甜美中和了龙舌兰的浓烈。",
    "story": "最初的版本诞生于1930年代亚利桑那州的比尔特莫尔酒店。而我们现在熟知的橙汁加红石榴糖浆的版本，则是1970年代加州Sausalito的Trident酒吧发明的，后来因为滚石乐队主唱米克·贾格尔在巡演期间疯狂点这款酒而风靡全球。",
    "ingredients": [
      { "name_zh": "银龙舌兰", "name_en": "Tequila Blanco", "amount": 45, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜橙汁", "name_en": "Orange Juice", "amount": 90, "unit": "ml", "is_optional": false },
      { "name_zh": "红石榴糖浆", "name_en": "Grenadine", "amount": 15, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在装满冰块的高筒杯中倒入龙舌兰和橙汁。" },
      { "step_number": 2, "instruction": "将红石榴糖浆沿着杯壁或吧勺背面缓慢倒入杯中。" },
      { "step_number": 3, "instruction": "糖浆会沉入杯底，形成日出般的红色到黄色的渐变。不要搅拌。" },
      { "step_number": 4, "instruction": "用半片橙子或樱桃进行装饰。" }
    ],
    "method": "build",
    "glass_type": "highball",
    "ice_type": "cubed",
    "garnish": "半片橙子",
    "difficulty": 1,
    "abv": 12.0,
    "prep_time": 2,
    "flavor_profile": { "sweet": 4, "sour": 2, "bitter": 0, "strong": 2 },
    "occasion": ["morning", "brunch", "beach"],
    "season": ["summer", "spring"],
    "mood": ["bright", "energetic"],
    "image_url": "tequila_sunrise.png",
    "color": "#FF8C00",
    "origin": "California, USA",
    "year_created": 1970,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-tequila-03",
    "name_zh": "帕洛玛",
    "name_en": "Paloma",
    "category": "Tequila",
    "tags": ["New Era Drinks", "西柚", "清爽"],
    "description": "比玛格丽特更受墨西哥本地人欢迎的国民饮料。西柚汽水的微苦与青柠的酸爽，将龙舌兰的花香完美激发。",
    "story": "在西班牙语中意为“鸽子”。据说是由传奇的Tequila镇酒吧老板Don Javier Delgado Corona发明的。在墨西哥，人们更喜欢用当地的西柚苏打水（如Squirt）来搭配龙舌兰，清凉解渴。",
    "ingredients": [
      { "name_zh": "银龙舌兰", "name_en": "Tequila Blanco", "amount": 50, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜青柠汁", "name_en": "Lime Juice", "amount": 5, "unit": "ml", "is_optional": false },
      { "name_zh": "少许盐", "name_en": "Pinch of Salt", "amount": 1, "unit": "pinch", "is_optional": false },
      { "name_zh": "西柚苏打水", "name_en": "Pink Grapefruit Soda", "amount": 100, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在装满冰块的高筒杯中加入龙舌兰、青柠汁和一小撮盐。" },
      { "step_number": 2, "instruction": "加满粉红西柚苏打水。" },
      { "step_number": 3, "instruction": "用吧勺轻轻混合。" },
      { "step_number": 4, "instruction": "用一片西柚作为装饰。" }
    ],
    "method": "build",
    "glass_type": "highball",
    "ice_type": "cubed",
    "garnish": "西柚片",
    "difficulty": 1,
    "abv": 11.0,
    "prep_time": 2,
    "flavor_profile": { "sweet": 2, "sour": 3, "bitter": 2, "strong": 2 },
    "occasion": ["afternoon", "casual"],
