[
  {
    "id": "cocktail-brandy-01",
    "name_zh": "边车",
    "name_en": "Sidecar",
    "category": "Brandy",
    "tags": ["The Unforgettables", "干邑", "酸甜", "经典"],
    "description": "最负盛名的干邑白兰地鸡尾酒。柑橘的明亮酸度完美平衡了陈年干邑的醇厚橡木香与橙味利口酒的甜美。",
    "story": "诞生于一战后的巴黎（通常被归功于丽兹酒店的哈里酒吧）。据说是一位美国军官常坐着摩托车的边车（Sidecar）来到酒吧，调酒师便用当地的干邑为他特调了这杯酒并以此命名。",
    "ingredients": [
      { "name_zh": "干邑白兰地 (Cognac)", "name_en": "Cognac", "amount": 50, "unit": "ml", "is_optional": false },
      { "name_zh": "三倍橙酒 (Cointreau/Triple Sec)", "name_en": "Triple Sec", "amount": 20, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜柠檬汁", "name_en": "Lemon Juice", "amount": 20, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "（可选）用柠檬擦拭杯口并蘸上糖边。" },
      { "step_number": 2, "instruction": "将所有原料倒入摇酒壶中。" },
      { "step_number": 3, "instruction": "加入冰块，剧烈摇晃。" },
      { "step_number": 4, "instruction": "双重过滤至冰镇的碟形杯中，用橙皮卷装饰。" }
    ],
    "method": "shake",
    "glass_type": "coupe",
    "ice_type": "none",
    "garnish": "糖边与橙皮卷",
    "difficulty": 3,
    "abv": 26.0,
    "prep_time": 3,
    "flavor_profile": { "sweet": 2, "sour": 3, "bitter": 1, "strong": 4 },
    "occasion": ["after dinner", "bar"],
    "season": ["autumn", "winter"],
    "mood": ["elegant", "classic"],
    "image_url": "sidecar.png",
    "color": "#DAA520",
    "origin": "Paris, France",
    "year_created": 1922,
    "source": "IBA Official",
    "is_iba": true
