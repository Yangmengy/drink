  },
  {
    "id": "cocktail-brandy-07",
    "name_zh": "阿佩罗汽酒",
    "name_en": "Aperol Spritz",
    "category": "Liqueur",
    "tags": ["New Era Drinks", "开胃酒", "气泡", "意式"],
    "description": "全球最受欢迎的夏日开胃酒。醒目的亮橙色，带有橘皮的微苦和普罗塞克起泡酒的清爽气泡，酒精浓度极低。",
    "story": "源自意大利东北部的威尼托地区。在19世纪，奥匈帝国的士兵觉得当地的葡萄酒太烈，就在酒里喷水（Spritz 德语意为喷洒）。1919年 Aperol 品牌诞生后，这种加入苦橘利口酒的气泡饮品逐渐成为意式生活方式（La Dolce Vita）的标志。",
    "ingredients": [
      { "name_zh": "普罗塞克起泡酒", "name_en": "Prosecco", "amount": 90, "unit": "ml", "is_optional": false },
      { "name_zh": "阿佩罗 (Aperol)", "name_en": "Aperol", "amount": 60, "unit": "ml", "is_optional": false },
      { "name_zh": "苏打水", "name_en": "Soda Water", "amount": 30, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在大型红酒杯中装满冰块。" },
      { "step_number": 2, "instruction": "按照 3-2-1 的黄金比例：先倒入3份普罗塞克。" },
      { "step_number": 3, "instruction": "接着倒入2份阿佩罗。" },
      { "step_number": 4, "instruction": "最后加入1份苏打水封顶。" },
      { "step_number": 5, "instruction": "用吧勺轻轻从底部提拉一次，投入半片橙子装饰。" }
    ],
    "method": "build",
    "glass_type": "wine",
    "ice_type": "cubed",
    "garnish": "半片橙子",
    "difficulty": 1,
    "abv": 9.0,
    "prep_time": 2,
    "flavor_profile": { "sweet": 3, "sour": 1, "bitter": 2, "strong": 1 },
    "occasion": ["aperitif", "afternoon", "summer"],
    "season": ["summer", "spring"],
    "mood": ["bubbly", "social"],
    "image_url": "aperol_spritz.png",
    "color": "#FF4500",
    "origin": "Venice, Italy",
