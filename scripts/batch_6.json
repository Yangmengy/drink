  },
  {
    "id": "cocktail-brandy-08",
    "name_zh": "B52轰炸机",
    "name_en": "B-52",
    "category": "Liqueur",
    "tags": ["New Era Drinks", "分层", "烈酒一口闷", "火焰"],
    "description": "视觉效果极具冲击力的分层短饮。咖啡、百利甜与干邑形成了清晰的三色分层，最上层通常会被点燃。",
    "story": "诞生于1970年代。这杯酒的名字其实来源于美国著名的B-52同温层堡垒轰炸机。因为其需要“一口闷（Shooter）”的饮用方式和极具震撼力的火焰效果，成为了各大派对和夜店的宠儿。",
    "ingredients": [
      { "name_zh": "咖啡利口酒 (Kahlúa)", "name_en": "Coffee Liqueur", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "百利甜酒 (Baileys)", "name_en": "Irish Cream", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "干邑白兰地 或 柑橘酒 (Grand Marnier)", "name_en": "Cognac / Grand Marnier", "amount": 15, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在子弹杯（Shot Glass）底层倒入咖啡利口酒。" },
      { "step_number": 2, "instruction": "将吧勺反扣抵住杯壁，顺着吧勺背面极其缓慢地倒入百利甜酒，使其漂浮在咖啡酒之上形成第二层。" },
      { "step_number": 3, "instruction": "用同样的方法，将干邑或柑橘酒倒入作为最顶层。" },
      { "step_number": 4, "instruction": "饮用前点燃最上层的烈酒（需迅速插入吸管一口吸尽）。" }
    ],
    "method": "build",
    "glass_type": "shot",
    "ice_type": "none",
    "garnish": "火焰",
    "difficulty": 4,
    "abv": 27.0,
    "prep_time": 4,
    "flavor_profile": { "sweet": 5, "sour": 0, "bitter": 1, "strong": 4 },
    "occasion": ["party", "night out"],
    "season": ["all"],
    "mood": ["wild", "explosive"],
