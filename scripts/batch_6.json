  {
    "id": "cocktail-brandy-02",
    "name_zh": "白兰地亚历山大",
    "name_en": "Brandy Alexander",
    "category": "Brandy",
    "tags": ["The Unforgettables", "奶油", "可可", "甜点"],
    "description": "一杯真正的“液体甜点”。浓郁的可可香、顺滑的奶油与白兰地的醇厚融为一体，表面撒上的肉豆蔻粉是点睛之笔。",
    "story": "起源于20世纪初，最初版本使用的是金酒，被称为亚历山大。到了1920年代，为了庆祝玛丽公主和哈伍德伯爵的婚礼，调酒师用更昂贵的白兰地替换了金酒，从而让这款酒一跃成为上流社会的宠儿。",
    "ingredients": [
      { "name_zh": "干邑白兰地", "name_en": "Cognac", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "棕色可可利口酒", "name_en": "Crème de Cacao (brown)", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "鲜奶油", "name_en": "Fresh Cream", "amount": 30, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将所有原料倒入摇酒壶中。" },
      { "step_number": 2, "instruction": "加入大量冰块，用力摇晃直至完全乳化并冷却。" },
      { "step_number": 3, "instruction": "过滤至冰镇的碟形杯或马天尼杯中。" },
      { "step_number": 4, "instruction": "在表面现磨一些肉豆蔻粉作为装饰。" }
    ],
    "method": "shake",
    "glass_type": "coupe",
    "ice_type": "none",
    "garnish": "现磨肉豆蔻粉",
    "difficulty": 2,
    "abv": 18.0,
    "prep_time": 3,
    "flavor_profile": { "sweet": 5, "sour": 0, "bitter": 1, "strong": 3 },
    "occasion": ["after dinner", "dessert"],
    "season": ["winter"],
    "mood": ["indulgent", "cozy"],
    "image_url": "brandy_alexander.png",
    "color": "#D2B48C",
    "origin": "London, UK",
    "year_created": 1922,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-brandy-03",
    "name_zh": "皮斯科酸酒",
    "name_en": "Pisco Sour",
    "category": "Brandy",
    "tags": ["Contemporary Classics", "南美", "酸酒", "蛋白"],
    "description": "南美的国饮骄傲。清香扑鼻的葡萄白兰地（皮斯科）搭配青柠和糖浆，上面覆盖着厚厚的蛋白霜与几滴安格斯特拉苦精点缀。",
    "story": "秘鲁和智利为了这款酒的发源地争论不休。最广为接受的说法是，1920年代由旅居秘鲁首都利马的一位名叫 Victor Morris 的美国调酒师发明，他将传统的威士忌酸酒的基酒替换为了当地特产皮斯科酒。",
    "ingredients": [
      { "name_zh": "皮斯科酒 (Pisco)", "name_en": "Pisco", "amount": 60, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜青柠汁", "name_en": "Lime Juice", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "单糖浆", "name_en": "Simple Syrup", "amount": 20, "unit": "ml", "is_optional": false },
      { "name_zh": "生蛋清", "name_en": "Egg White", "amount": 1, "unit": "个", "is_optional": false },
      { "name_zh": "安格斯特拉苦精", "name_en": "Angostura Bitters", "amount": 3, "unit": "dash", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将皮斯科、青柠汁、糖浆和蛋清倒入摇酒壶。" },
      { "step_number": 2, "instruction": "不加冰进行干摇（Dry Shake）约15秒，以打发蛋清。" },
      { "step_number": 3, "instruction": "加入冰块，再次剧烈摇晃（Wet Shake）。" },
      { "step_number": 4, "instruction": "双重过滤至古典杯或高脚杯中。" },
      { "step_number": 5, "instruction": "在表面的蛋白霜上滴入3滴苦精作为装饰（同时掩盖蛋腥味）。" }
    ],
    "method": "shake",
    "glass_type": "old-fashioned",
    "ice_type": "none",
    "garnish": "滴在泡沫上的安格斯特拉苦精",
    "difficulty": 4,
    "abv": 22.0,
    "prep_time": 5,
    "flavor_profile": { "sweet": 3, "sour": 4, "bitter": 1, "strong": 4 },
    "occasion": ["dinner", "bar"],
    "season": ["summer", "spring"],
    "mood": ["exotic", "smooth"],
    "image_url": "pisco_sour.png",
    "color": "#FDF5E6",
    "origin": "Lima, Peru",
    "year_created": 1920,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-brandy-04",
    "name_zh": "老广场",
    "name_en": "Vieux Carré",
    "category": "Brandy",
    "tags": ["The Unforgettables", "黑麦威士忌", "干邑", "草本"],
    "description": "新奥尔良文化的浓缩体。黑麦威士忌的辛香、干邑的醇厚、甜味美思与廊酒（Bénédictine）的复杂草药味交织在一起。",
    "story": "由新奥尔良著名 Monteleone 酒店的旋转木马酒吧首席调酒师 Walter Bergeron 在1938年创造。Vieux Carré 在法语中意为“老广场”，即新奥尔良法国区的代名词，这杯酒完美致敬了这座城市的多元文化。",
    "ingredients": [
      { "name_zh": "黑麦威士忌", "name_en": "Rye Whiskey", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "干邑白兰地", "name_en": "Cognac", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "甜味美思", "name_en": "Sweet Vermouth", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "廊酒 (Bénédictine)", "name_en": "Bénédictine", "amount": 1, "unit": "tsp", "is_optional": false },
      { "name_zh": "裴乔氏苦精", "name_en": "Peychaud's Bitters", "amount": 2, "unit": "dash", "is_optional": false },
      { "name_zh": "安格斯特拉苦精", "name_en": "Angostura Bitters", "amount": 2, "unit": "dash", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在混合杯（Mixing Glass）中加入所有原料。" },
      { "step_number": 2, "instruction": "加入冰块，用吧勺平稳地搅拌约20-30秒至充分冷却。" },
      { "step_number": 3, "instruction": "过滤至装有单块大冰块的古典杯中。" },
      { "step_number": 4, "instruction": "用柠檬皮卷或樱桃进行装饰。" }
    ],
    "method": "stir",
    "glass_type": "old-fashioned",
    "ice_type": "cubed",
    "garnish": "柠檬皮卷或樱桃",
    "difficulty": 3,
    "abv": 28.0,
    "prep_time": 4,
    "flavor_profile": { "sweet": 3, "sour": 0, "bitter": 3, "strong": 5 },
    "occasion": ["night out", "cigar"],
    "season": ["autumn", "winter"],
    "mood": ["complex", "historic"],
    "image_url": "vieux_carre.png",
    "color": "#8B4513",
    "origin": "New Orleans, USA",
    "year_created": 1938,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-brandy-05",
    "name_zh": "法国情怀 (法国贩毒网)",
    "name_en": "French Connection",
    "category": "Brandy",
    "tags": ["Contemporary Classics", "极简", "杏仁", "餐后酒"],
    "description": "优雅的法式双重奏。干邑白兰地的葡萄桶香与意大利苦杏仁酒的甜美无缝连接，入口温润醉人。",
    "story": "得名于1971年由吉恩·哈克曼主演的奥斯卡最佳影片《法国贩毒网》(The French Connection)。它是70年代流行的“双料（Duo）”鸡尾酒家族之一，与教父（Godfather）和生锈钉（Rusty Nail）齐名。",
    "ingredients": [
      { "name_zh": "干邑白兰地", "name_en": "Cognac", "amount": 35, "unit": "ml", "is_optional": false },
      { "name_zh": "苦杏仁酒 (Amaretto)", "name_en": "Amaretto", "amount": 35, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在古典杯中装满大冰块。" },
      { "step_number": 2, "instruction": "倒入干邑白兰地和苦杏仁酒。" },
      { "step_number": 3, "instruction": "用吧勺轻轻搅拌几下以冷却混合。" },
      { "step_number": 4, "instruction": "直接饮用，无需装饰（或可选橙皮卷）。" }
    ],
    "method": "build",
    "glass_type": "old-fashioned",
    "ice_type": "cubed",
    "garnish": "无",
    "difficulty": 1,
    "abv": 28.0,
    "prep_time": 1,
    "flavor_profile": { "sweet": 4, "sour": 0, "bitter": 1, "strong": 4 },
    "occasion": ["after dinner", "night"],
    "season": ["winter", "autumn"],
    "mood": ["warm", "intimate"],
    "image_url": "french_connection.png",
    "color": "#CD853F",
    "origin": "USA",
    "year_created": 1971,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-brandy-06",
    "name_zh": "杏仁酸酒",
    "name_en": "Amaretto Sour",
    "category": "Liqueur",
    "tags": ["Classic", "酸甜", "坚果", "易饮"],
    "description": "像是液体版的杏仁蛋白软糖。柠檬的酸味完美抵消了苦杏仁酒的高甜度，加入少许波旁威士忌（现代配方）更能提升酒体结构。",
    "story": "1970年代风靡全美的迪斯科时代饮品。最初因为仅使用商业酸甜汁和杏仁酒而显得过于甜腻，直到著名调酒师 Jeffrey Morgenthaler 改进了配方，加入了桶强波旁威士忌和新鲜柠檬汁，让它在现代高级酒吧中重获新生。",
    "ingredients": [
      { "name_zh": "苦杏仁酒 (Amaretto)", "name_en": "Amaretto Liqueur", "amount": 45, "unit": "ml", "is_optional": false },
      { "name_zh": "高年份波旁威士忌", "name_en": "Cask-Proof Bourbon", "amount": 20, "unit": "ml", "is_optional": true },
      { "name_zh": "新鲜柠檬汁", "name_en": "Lemon Juice", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "单糖浆", "name_en": "Simple Syrup", "amount": 10, "unit": "ml", "is_optional": false },
      { "name_zh": "生蛋清", "name_en": "Egg White", "amount": 1, "unit": "个", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将所有原料倒入摇酒壶中。" },
      { "step_number": 2, "instruction": "进行干摇（Dry Shake）以打发蛋清至起泡。" },
      { "step_number": 3, "instruction": "加入冰块，再次剧烈摇晃。" },
      { "step_number": 4, "instruction": "过滤至装有冰块的古典杯中。" },
      { "step_number": 5, "instruction": "用柠檬皮卷和一颗黑樱桃装饰。" }
    ],
    "method": "shake",
    "glass_type": "old-fashioned",
    "ice_type": "cubed",
    "garnish": "柠檬皮卷与樱桃",
    "difficulty": 3,
    "abv": 15.0,
    "prep_time": 4,
    "flavor_profile": { "sweet": 4, "sour": 3, "bitter": 1, "strong": 2 },
    "occasion": ["casual", "dinner"],
