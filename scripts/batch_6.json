  {
    "id": "cocktail-brandy-09",
    "name_zh": "绿色蚱蜢",
    "name_en": "Grasshopper",
    "category": "Liqueur",
    "tags": ["Contemporary Classics", "薄荷", "可可", "奶油"],
    "description": "像是融化的薄荷巧克力冰淇淋。呈现极其鲜艳的柔和绿色，口感顺滑浓郁，是晚宴后的完美甜点酒。",
    "story": "在1918年由新奥尔良著名法国餐厅 Tujague's 的老板 Philip Guichet 参加纽约鸡尾酒比赛时发明，并赢得了第二名。随后在1950年代的美国南部广为流行。",
    "ingredients": [
      { "name_zh": "绿色薄荷利口酒", "name_en": "Crème de Menthe (green)", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "白色可可利口酒", "name_en": "Crème de Cacao (white)", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "鲜奶油", "name_en": "Fresh Cream", "amount": 30, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将所有原料倒入摇酒壶中。" },
