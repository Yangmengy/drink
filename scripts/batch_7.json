  {
    "id": "cocktail-conv-01",
    "name_zh": "野格炸弹",
    "name_en": "Jägerbomb",
    "category": "便利店",
    "tags": ["便利店调酒", "提神", "派对"],
    "description": "最经典的夜店/便利店爆款组合。野格浓郁的草药味与红牛的甜腻气泡碰撞，一口闷下，瞬间提神醒脑。",
    "story": "风靡全球年轻人的经典喝法。在便利店只需买一小瓶50ml的野格酒版和一罐红牛，在路边就能立刻开启派对模式。",
    "ingredients": [
      { "name_zh": "野格利口酒 (酒版)", "name_en": "Jägermeister", "amount": 50, "unit": "ml", "is_optional": false },
      { "name_zh": "红牛饮料", "name_en": "Red Bull", "amount": 150, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在塑料杯或高筒玻璃杯中倒入大半杯红牛。" },
      { "step_number": 2, "instruction": "将一整小瓶野格（或将野格倒入子弹杯）直接“炸”入红牛中。" },
      { "step_number": 3, "instruction": "趁着气泡翻腾，一口气喝完。" }
    ],
