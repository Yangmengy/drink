    ],
    "steps": [
      { "step_number": 1, "instruction": "杯中加满冰块。" },
      { "step_number": 2, "instruction": "倒入梅酒和苏打水（推荐比例1:2）。" },
      { "step_number": 3, "instruction": "如果有梅酒瓶里的青梅，捞出一颗放进杯中。" }
    ],
