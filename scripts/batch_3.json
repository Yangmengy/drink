  },
  {
    "id": "cocktail-rum-06",
    "name_zh": "月黑风高",
    "name_en": "Dark 'n' Stormy",
    "category": "Rum",
    "tags": ["New Era Drinks", "姜汁啤酒", "辛辣"],
    "description": "黑朗姆酒漂浮在辛辣的姜汁啤酒上，如同风暴来临前昏暗汹涌的海面，口感炽烈而清爽。",
    "story": "百慕大群岛的官方鸡尾酒。一战后，当地的Gosling兄弟将他们的深色黑海豹朗姆酒（Black Seal Rum）加到英国皇家海军酿造的姜汁啤酒中。一位水手看到杯中的颜色后说：“这颜色就像连死神都不愿意穿越的风暴”，由此得名。",
    "ingredients": [
      { "name_zh": "深色黑朗姆酒 (如Gosling's)", "name_en": "Dark Rum", "amount": 60, "unit": "ml", "is_optional": false },
      { "name_zh": "姜汁啤酒", "name_en": "Ginger Beer", "amount": 100, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜青柠汁", "name_en": "Lime Juice", "amount": 15, "unit": "ml", "is_optional": true }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在装满冰块的高筒杯中倒入姜汁啤酒和青柠汁。" },
      { "step_number": 2, "instruction": "将深色黑朗姆酒顺着吧勺背面轻轻倒在表面，使其漂浮（Float）在杯子最上层，形成分层效果。" },
      { "step_number": 3, "instruction": "用一片青柠进行装饰。" }
    ],
    "method": "build",
    "glass_type": "highball",
    "ice_type": "cubed",
    "garnish": "青柠角",
    "difficulty": 2,
    "abv": 14.0,
    "prep_time": 3,
    "flavor_profile": { "sweet": 3, "sour": 2, "bitter": 1, "strong": 3 },
    "occasion": ["casual", "stormy day"],
    "season": ["autumn", "winter"],
    "mood": ["adventurous", "spicy"],
    "image_url": "dark_n_stormy.png",
    "color": "#8B4513",
    "origin": "Bermuda",
    "year_created": 1920,
