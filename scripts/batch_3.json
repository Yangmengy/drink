[
  {
    "id": "cocktail-rum-01",
    "name_zh": "莫吉托",
    "name_en": "Mojito",
    "category": "Rum",
    "tags": ["Contemporary Classics", "薄荷", "清凉", "夏日"],
    "description": "古巴的国民饮料。白朗姆酒、新鲜薄荷与青柠的完美结合，清爽解渴的极致代表。",
    "story": "诞生于古巴哈瓦那，据说是16世纪英国海盗弗朗西斯·德雷克的手下为了对抗坏血病和痢疾，用当地的甘蔗酒（朗姆酒的前身）、薄荷和青柠混合而成的药酒演变而来。",
    "ingredients": [
      { "name_zh": "白朗姆酒", "name_en": "White Rum", "amount": 45, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜青柠汁", "name_en": "Fresh Lime Juice", "amount": 20, "unit": "ml", "is_optional": false },
      { "name_zh": "薄荷叶", "name_en": "Mint Leaves", "amount": 6, "unit": "片", "is_optional": false },
      { "name_zh": "白砂糖", "name_en": "White Sugar", "amount": 2, "unit": "吧勺", "is_optional": false },
      { "name_zh": "苏打水", "name_en": "Soda Water", "amount": 60, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在海波杯或柯林杯中加入青柠汁、白砂糖和薄荷叶。" },
      { "step_number": 2, "instruction": "用捣棒极轻柔地按压薄荷（切勿捣碎发苦）。" },
      { "step_number": 3, "instruction": "倒入白朗姆酒，加入碎冰至杯子八分满。" },
      { "step_number": 4, "instruction": "用吧勺上下提拉搅拌至杯壁结霜。" },
      { "step_number": 5, "instruction": "再加满碎冰，注满苏打水，放上一簇新鲜薄荷作为装饰。" }
    ],
    "method": "muddle",
    "glass_type": "highball",
    "ice_type": "crushed",
    "garnish": "一簇新鲜薄荷枝与青柠角",
    "difficulty": 2,
    "abv": 12.0,
    "prep_time": 4,
    "flavor_profile": { "sweet": 2, "sour": 3, "bitter": 1, "strong": 2 },
    "occasion": ["summer", "party", "beach"],
    "season": ["summer", "spring"],
    "mood": ["refreshing", "energetic"],
    "image_url": "mojito.png",
    "color": "#E0FFD1",
    "origin": "Havana, Cuba",
    "year_created": 1586,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-rum-02",
    "name_zh": "大吉岭",
    "name_en": "Daiquiri",
    "category": "Rum",
    "tags": ["The Unforgettables", "酸甜", "经典"],
    "description": "极其纯粹的酸甜平衡艺术。只有朗姆酒、青柠汁和糖浆三样原料，却千变万化。",
    "story": "得名于古巴圣地亚哥附近的一个铁矿小镇 Daiquirí。1898年，一位名叫Jennings Cox的美国采矿工程师因为手头没有杜松子酒来招待客人，便用当地的朗姆酒混合了青柠和糖，创造了这款旷世杰作。",
    "ingredients": [
      { "name_zh": "白朗姆酒", "name_en": "White Rum", "amount": 60, "unit": "ml", "is_optional": false },
      { "name_zh": "鲜榨青柠汁", "name_en": "Fresh Lime Juice", "amount": 20, "unit": "ml", "is_optional": false },
      { "name_zh": "单糖浆", "name_en": "Simple Syrup", "amount": 15, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将朗姆酒、青柠汁和糖浆倒入摇酒壶中。" },
      { "step_number": 2, "instruction": "加入冰块，用力摇晃（Shake）10-15秒。" },
      { "step_number": 3, "instruction": "双重过滤至冰镇好的碟形杯或马天尼杯中。" },
      { "step_number": 4, "instruction": "用青柠角或半片青柠作为装饰（也可不装饰）。" }
    ],
    "method": "shake",
    "glass_type": "coupe",
    "ice_type": "none",
    "garnish": "青柠角",
    "difficulty": 2,
    "abv": 22.0,
    "prep_time": 3,
    "flavor_profile": { "sweet": 2, "sour": 4, "bitter": 0, "strong": 3 },
    "occasion": ["dinner", "bar"],
    "season": ["summer", "spring"],
    "mood": ["sharp", "elegant"],
    "image_url": "daiquiri.png",
    "color": "#E6F8E0",
    "origin": "Daiquirí, Cuba",
    "year_created": 1898,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-rum-03",
    "name_zh": "椰林飘香",
    "name_en": "Piña Colada",
    "category": "Rum",
    "tags": ["Contemporary Classics", "热带", "椰子", "冰沙"],
    "description": "终极的热带度假饮品。椰浆的醇厚奶香与菠萝的酸甜果味完美交融，仿佛置身加勒比海滩。",
    "story": "波多黎各的官方国饮。1954年由圣胡安的加勒比希尔顿酒店的调酒师Ramón \"Monchito\" Marrero花费数月时间研发而成，完美捕捉了热带岛屿的阳光与海滩。",
    "ingredients": [
      { "name_zh": "白朗姆酒", "name_en": "White Rum", "amount": 50, "unit": "ml", "is_optional": false },
      { "name_zh": "椰浆", "name_en": "Coconut Cream", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜菠萝汁", "name_en": "Fresh Pineapple Juice", "amount": 50, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将所有原料与一杯碎冰一起倒入搅拌机（Blender）中。" },
      { "step_number": 2, "instruction": "高速搅打至呈现顺滑的冰沙状。" },
      { "step_number": 3, "instruction": "倒入大号的飓风杯或高筒杯中。" },
      { "step_number": 4, "instruction": "用菠萝片和一颗马拉斯奇诺樱桃作为装饰。" }
    ],
    "method": "blend",
    "glass_type": "hurricane",
    "ice_type": "crushed",
    "garnish": "菠萝片与樱桃",
    "difficulty": 2,
    "abv": 10.0,
    "prep_time": 4,
    "flavor_profile": { "sweet": 5, "sour": 2, "bitter": 0, "strong": 2 },
    "occasion": ["beach", "party", "summer"],
    "season": ["summer"],
    "mood": ["tropical", "vacation"],
    "image_url": "pina_colada.png",
    "color": "#FFFDD0",
    "origin": "Puerto Rico",
    "year_created": 1954,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-rum-04",
    "name_zh": "迈泰",
    "name_en": "Mai Tai",
    "category": "Rum",
    "tags": ["Contemporary Classics", "Tiki", "杏仁", "复杂"],
    "description": "Tiki 文化的巅峰之作。多重朗姆酒的陈年木香、杏仁糖浆的坚果味与新鲜柑橘结合，狂野而深邃。",
    "story": "由Tiki酒吧先驱“Trader Vic”在1944年的加州发明。当他将这杯酒端给几位来自大溪地的朋友品尝时，其中一位惊呼“Maita'i roa ae!”（大溪地语，意为“好极了，出神入化”），这款酒由此得名。",
    "ingredients": [
      { "name_zh": "牙买加黑朗姆酒", "name_en": "Jamaican Dark Rum", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "马提尼克岛农业朗姆酒", "name_en": "Martinique Rhum Agricole", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜青柠汁", "name_en": "Lime Juice", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "橙味干邑利口酒", "name_en": "Orange Curaçao", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "杏仁糖浆", "name_en": "Orgeat Syrup", "amount": 15, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将除了黑朗姆酒之外的所有原料倒入摇酒壶。" },
      { "step_number": 2, "instruction": "加入冰块剧烈摇匀。" },
      { "step_number": 3, "instruction": "连同冰块一起倒入古典杯或Tiki杯中。" },
      { "step_number": 4, "instruction": "将黑朗姆酒轻轻倒在表面（Float）。" },
      { "step_number": 5, "instruction": "插上一大株新鲜薄荷和半个榨过的青柠壳（象征热带岛屿）。" }
    ],
    "method": "shake",
    "glass_type": "old-fashioned",
    "ice_type": "cubed",
    "garnish": "青柠壳与丰满的薄荷枝",
    "difficulty": 4,
    "abv": 24.0,
    "prep_time": 4,
    "flavor_profile": { "sweet": 3, "sour": 3, "bitter": 1, "strong": 4 },
    "occasion": ["party", "beach", "bar"],
    "season": ["summer"],
    "mood": ["exotic", "wild"],
    "image_url": "mai_tai.png",
    "color": "#D2691E",
    "origin": "California, USA",
    "year_created": 1944,
    "source": "IBA Official",
    "is_iba": true
  },
  {
    "id": "cocktail-rum-05",
    "name_zh": "自由古巴",
    "name_en": "Cuba Libre",
    "category": "Rum",
    "tags": ["Contemporary Classics", "可乐", "长饮"],
    "description": "极简的长饮代表。冰镇可乐带来的刺激气泡搭配陈年朗姆酒的甘蔗香甜，青柠汁是注入灵魂的关键。",
    "story": "在美西战争期间（1900年左右），美国士兵在哈瓦那将当地的百加得朗姆酒与刚进入古巴的美国可口可乐混合。喝下这杯酒时，他们高呼“Por Cuba Libre!”（为了古巴的自由），这款酒便有了这个响亮的名字。",
    "ingredients": [
      { "name_zh": "白或金朗姆酒", "name_en": "White or Gold Rum", "amount": 50, "unit": "ml", "is_optional": false },
      { "name_zh": "可乐", "name_en": "Cola", "amount": 120, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜青柠汁", "name_en": "Lime Juice", "amount": 10, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "在海波杯或高筒杯中装满冰块。" },
      { "step_number": 2, "instruction": "倒入朗姆酒和挤入新鲜青柠汁。" },
      { "step_number": 3, "instruction": "加满冰冷的可乐。" },
      { "step_number": 4, "instruction": "用吧勺轻轻提拉一次混合，用青柠角装饰。" }
    ],
    "method": "build",
    "glass_type": "highball",
    "ice_type": "cubed",
    "garnish": "青柠角",
    "difficulty": 1,
    "abv": 11.0,
    "prep_time": 2,
    "flavor_profile": { "sweet": 4, "sour": 1, "bitter": 0, "strong": 2 },
    "occasion": ["casual", "party", "summer"],
    "season": ["summer", "spring"],
    "mood": ["relaxed", "energetic"],
    "image_url": "cuba_libre.png",
    "color": "#3E2723",
    "origin": "Havana, Cuba",
    "year_created": 1900,
    "source": "IBA Official",
