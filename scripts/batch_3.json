  },
  {
    "id": "cocktail-rum-07",
    "name_zh": "僵尸",
    "name_en": "Zombie",
    "category": "Rum",
    "tags": ["Contemporary Classics", "Tiki", "超烈", "果味"],
    "description": "名副其实的致命诱惑。混合了三种不同年份和烈度的朗姆酒与大量热带果汁，喝下后足以让人像僵尸一样失去意识。",
    "story": "由好莱坞Tiki酒吧创始人Donn Beach于1934年发明。据说他为了帮助一位喝醉的商人顾客解酒，反而混合出了这杯极其猛烈的酒。几天后那个顾客回来抱怨说，这杯酒让他整整几天感觉像个僵尸。",
    "ingredients": [
      { "name_zh": "牙买加黑朗姆酒", "name_en": "Dark Jamaican Rum", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "波多黎各金朗姆酒", "name_en": "Gold Puerto Rican Rum", "amount": 30, "unit": "ml", "is_optional": false },
      { "name_zh": "151防超高纯度朗姆酒", "name_en": "151-proof Demerara Rum", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜青柠汁", "name_en": "Lime Juice", "amount": 20, "unit": "ml", "is_optional": false },
      { "name_zh": "法勒南糖浆 (Falernum)", "name_en": "Falernum", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "葡萄柚汁", "name_en": "Grapefruit Juice", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "肉桂糖浆", "name_en": "Cinnamon Syrup", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "苦艾酒", "name_en": "Absinthe", "amount": 1, "unit": "dash", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将除151朗姆酒外的所有原料倒入搅拌机，加入一杯碎冰。" },
      { "step_number": 2, "instruction": "高速搅打（Blend）约5秒钟。" },
      { "step_number": 3, "instruction": "倒入大号的Tiki杯或飓风杯中。" },
      { "step_number": 4, "instruction": "将高纯度151朗姆酒倒在表面（部分老派做法会将其点燃）。" },
      { "step_number": 5, "instruction": "插上大量薄荷枝作为装饰。" }
    ],
    "method": "blend",
    "glass_type": "hurricane",
    "ice_type": "crushed",
    "garnish": "薄荷枝",
    "difficulty": 5,
    "abv": 28.0,
    "prep_time": 5,
    "flavor_profile": { "sweet": 4, "sour": 3, "bitter": 1, "strong": 5 },
    "occasion": ["party", "bar"],
    "season": ["summer"],
    "mood": ["dangerous", "wild"],
    "image_url": "zombie.png",
    "color": "#DAA520",
    "origin": "Hollywood, USA",
    "year_created": 1934,
    "source": "Classic",
    "is_iba": true
  },
  {
    "id": "cocktail-rum-08",
    "name_zh": "丛林鸟",
    "name_en": "Jungle Bird",
