  {
    "id": "cocktail-rum-09",
    "name_zh": "海明威特调",
    "name_en": "Hemingway Special",
    "category": "Rum",
    "tags": ["Contemporary Classics", "酸烈", "无糖"],
    "description": "为嗜酒如命的大文豪量身定制，酸涩凛冽的葡萄柚与黑樱桃酒香取代了糖浆的甜腻，极其强劲。",
    "story": "著名作家海明威在古巴哈瓦那的“小佛罗里达”酒吧点Daiquiri时，对酒保说：“我不想要糖，朗姆酒要双倍（Papa Doble）。”为了平衡酸度，酒保加入了西柚汁和黑樱桃利口酒，便诞生了这款硬汉专属特调。",
    "ingredients": [
      { "name_zh": "白朗姆酒", "name_en": "White Rum", "amount": 60, "unit": "ml", "is_optional": false },
