    "tags": ["Tiki", "苦甜", "菠萝"],
    "description": "罕见的带有浓郁苦味的Tiki鸡尾酒，金巴利的苦味与菠萝汁的甜美形成绝妙的冲突美学。",
    "story": "诞生于1970年代的马来西亚吉隆坡希尔顿酒店的Aviary酒吧（鸟舍酒吧）。作为一杯迎宾饮料送给客人们，由于其杯中使用了丰富的菠萝叶作为装饰，形似一只展翅的丛林鸟而得名。",
    "ingredients": [
      { "name_zh": "深色牙买加朗姆酒", "name_en": "Dark Jamaican Rum", "amount": 45, "unit": "ml", "is_optional": false },
      { "name_zh": "金巴利", "name_en": "Campari", "amount": 22.5, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜菠萝汁", "name_en": "Pineapple Juice", "amount": 45, "unit": "ml", "is_optional": false },
      { "name_zh": "新鲜青柠汁", "name_en": "Lime Juice", "amount": 15, "unit": "ml", "is_optional": false },
      { "name_zh": "单糖浆", "name_en": "Simple Syrup", "amount": 15, "unit": "ml", "is_optional": false }
    ],
    "steps": [
      { "step_number": 1, "instruction": "将所有原料倒入摇酒壶中。" },
      { "step_number": 2, "instruction": "加入冰块，用力摇晃。" },
      { "step_number": 3, "instruction": "过滤至装有冰块的古典杯中。" },
      { "step_number": 4, "instruction": "使用三片长的菠萝叶和一颗樱桃进行装饰，模仿鸟类的尾巴。" }
