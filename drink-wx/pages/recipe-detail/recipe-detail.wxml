<!--pages/recipe-detail/recipe-detail.wxml - 配方详情页-->
<view class="page">
  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBack">
    <text class="back-icon">‹</text>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view wx:elif="{{recipe}}" class="content">
    <!-- 配方图片 -->
    <view class="image-container">
      <view class="recipe-image">🍸</view>
      <view class="image-overlay"></view>
    </view>

    <!-- 配方标题 -->
    <view class="header-card glass-card">
      <view class="title-row">
        <view class="title-group">
          <view class="recipe-name">{{recipe.name_zh}}</view>
          <view class="recipe-name-en">{{recipe.name_en}}</view>
        </view>
        <view class="favorite-btn" bindtap="toggleFavorite">
          <text class="heart-icon">{{isFavorite ? '♥' : '♡'}}</text>
        </view>
      </view>

      <!-- 配方信息 -->
      <view class="info-row">
        <view class="info-item">
          <text class="info-icon">🍷</text>
          <text class="info-label">{{recipe.category}}</text>
        </view>
        <view class="info-item">
          <text class="info-icon">⚡</text>
          <text class="info-label">{{recipe.abv}}%</text>
        </view>
        <view class="info-item">
          <text class="info-icon">⭐</text>
          <text class="info-label">{{recipe.difficulty}}</text>
        </view>
      </view>
    </view>

    <!-- 配方描述 -->
    <view wx:if="{{recipe.description}}" class="section-card glass-card">
      <view class="section-title">简介</view>
      <view class="description-text">{{recipe.description}}</view>
    </view>

    <!-- 原料列表 -->
    <view class="section-card glass-card">
      <view class="section-title">原料清单</view>
      <view class="ingredients-list">
        <view 
          wx:for="{{recipe.ingredients}}" 
          wx:key="id"
          class="ingredient-row"
        >
          <view class="ingredient-info">
            <text class="ingredient-icon">🧪</text>
            <text class="ingredient-name">{{item.name}}</text>
          </view>
          <text class="ingredient-amount">{{item.amount}} {{item.unit}}</text>
        </view>
      </view>
    </view>

    <!-- 调制步骤 -->
    <view wx:if="{{recipe.steps && recipe.steps.length > 0}}" class="section-card glass-card">
      <view class="section-title">调制步骤</view>
      <view class="steps-list">
        <view 
          wx:for="{{recipe.steps}}" 
          wx:key="index"
          class="step-row"
        >
          <view class="step-number">{{index + 1}}</view>
          <view class="step-text">{{item}}</view>
        </view>
      </view>
    </view>

    <!-- 杯具和装饰 -->
    <view class="section-card glass-card">
      <view class="info-grid">
        <view wx:if="{{recipe.glass}}" class="info-block">
          <view class="info-block-label">杯具</view>
          <view class="info-block-value">{{recipe.glass}}</view>
        </view>
        <view wx:if="{{recipe.garnish}}" class="info-block">
          <view class="info-block-label">装饰</view>
          <view class="info-block-value">{{recipe.garnish}}</view>
        </view>
      </view>
    </view>

    <!-- 底部操作按钮 -->
    <view class="action-bar glass-card">
      <button class="action-btn primary" bindtap="addToTodo">
        <text class="btn-icon">📋</text>
        <text class="btn-text">加入清单</text>
      </button>
      <button class="action-btn" bindtap="startMaking">
        <text class="btn-icon">🍹</text>
        <text class="btn-text">开始调制</text>
      </button>
    </view>
  </view>

  <view wx:else class="error">
    <text class="error-emoji">😕</text>
    <text class="error-text">配方加载失败</text>
    <button class="retry-btn" bindtap="loadRecipe">重试</button>
  </view>
</view>