<!--pages/record/record.wxml - 饮酒记录页-->
<view class="page">
  <!-- 导航栏 -->
  <view class="navbar">
    <view class="navbar-title">饮酒记录</view>
    <view class="navbar-subtitle">JOURNAL</view>
  </view>

  <view class="content">
    <!-- 日历卡片 -->
    <view class="calendar-card glass-card">
      <view class="calendar-header">
        <text class="calendar-icon">📅</text>
        <text class="calendar-title">{{currentMonth}}</text>
      </view>
      <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
        <view class="date-picker">
          <text class="date-text">{{selectedDate}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <!-- 月度统计卡片 -->
    <view class="summary-card glass-card">
      <view class="summary-info">
        <view class="summary-label">本月</view>
        <view class="summary-value">
          <text class="summary-count">{{monthlyCount}}</text>
          <text class="summary-unit">杯</text>
        </view>
      </view>
      <view class="summary-icon">🍸</view>
    </view>

    <!-- 记录列表 -->
    <view class="section">
      <view class="section-header">
        <view class="section-title">今日记录</view>
        <view class="record-count">{{records.length}}</view>
      </view>

      <view wx:if="{{loading}}" class="loading">加载中...</view>

      <view wx:elif="{{records.length > 0}}" class="records-list">
        <view 
          wx:for="{{records}}" 
          wx:key="id"
          class="record-card glass-card"
          bindtap="viewRecord"
          data-id="{{item.id}}"
        >
          <view class="record-header">
            <view class="record-drink">
              <text class="drink-icon">🍹</text>
              <text class="drink-name">{{item.name}}</text>
            </view>
            <view class="record-time">{{item.time}}</view>
          </view>

          <view wx:if="{{item.notes}}" class="record-notes">
            {{item.notes}}
          </view>

          <view wx:if="{{item.rating}}" class="record-rating">
            <text class="star-icon">⭐</text>
            <text class="rating-value">{{item.rating}}</text>
          </view>

          <view class="record-actions">
            <view 
              class="delete-btn" 
              catchtap="deleteRecord"
              data-id="{{item.id}}"
            >
              删除
            </view>
          </view>
        </view>
      </view>

      <view wx:else class="empty">
        <text class="empty-emoji">🥂</text>
        <view class="empty-title">今天还没有记录</view>
        <view class="empty-desc">记录下今天的微醺时刻吧</view>
      </view>
    </view>
  </view>

  <!-- 悬浮按钮 -->
  <view class="fab" bindtap="addRecord">
    <text class="fab-icon">+</text>
  </view>
</view>