/* pages/profile/profile.wxss - 1:1 复原原版我的页面 */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 120rpx;
}

/* ========== 导航栏 ========== */
.navbar {
  padding: 24rpx 40rpx;
  background: var(--bg-page);
}

.navbar-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.navbar-subtitle {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 600;
  letter-spacing: 0.1em;
  margin-top: 4rpx;
}

/* ========== 内容区 ========== */
.content {
  padding: 0 40rpx;
}

/* ========== 毛玻璃卡片基础样式 ========== */
.glass-card {
  background: var(--bg-elevated);
  backdrop-filter: blur(48rpx) saturate(180%);
  border-radius: var(--radius-large);
  border: 1rpx solid var(--border-glass);
  box-shadow: var(--shadow-lg);
  transition: all 0.3s ease;
}

.glass-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-xl);
}

/* ========== 用户信息卡片 ========== */
.user-card {
  display: flex;
  align-items: center;
  padding: 32rpx;
  margin-bottom: 32rpx;
  gap: 24rpx;
}

.avatar-container {
  flex-shrink: 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, rgba(78, 205, 196, 0.2), rgba(255, 107, 107, 0.15));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: var(--color-accent);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.user-info {
  flex: 1;
  min-width: 0;
}

.username {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-primary);
  margin-bottom: 8rpx;
  letter-spacing: -0.01em;
}

.user-bio {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.4;
}

.user-arrow {
  font-size: 48rpx;
  color: var(--text-tertiary);
  opacity: 0.4;
}

/* ========== 统计卡片网格 ========== */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 32rpx 16rpx;
  text-align: center;
  gap: 8rpx;
}

.stat-icon {
  font-size: 44rpx;
  margin-bottom: 8rpx;
}

.stat-number {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text-primary);
  line-height: 1;
}

.stat-label {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 4rpx;
}

/* ========== 设置区域 ========== */
.settings-section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  letter-spacing: -0.01em;
}

.settings-list {
  background: var(--bg-elevated);
  backdrop-filter: blur(48rpx) saturate(180%);
  border-radius: var(--radius-large);
  border: 1rpx solid var(--border-glass);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.settings-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  gap: 24rpx;
  border-bottom: 1rpx solid var(--border-glass);
  transition: all 0.2s;
}

.settings-item:last-child {
  border-bottom: none;
}

.settings-item:active {
  background: rgba(0, 0, 0, 0.02);
}

.settings-icon {
  font-size: 40rpx;
  flex-shrink: 0;
}

.settings-label {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.settings-arrow {
  font-size: 40rpx;
  color: var(--text-tertiary);
  opacity: 0.4;
}

/* ========== 版本号 ========== */
.version-text {
  text-align: center;
  font-size: 22rpx;
  color: var(--text-quaternary);
  padding: 32rpx 0;
}
