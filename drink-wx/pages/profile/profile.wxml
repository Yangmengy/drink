<!--pages/profile/profile.wxml - 1:1 复原原版我的页面-->
<view class="page">
  <!-- 导航栏 -->
  <view class="navbar">
    <view class="navbar-title">我的</view>
    <view class="navbar-subtitle">PROFILE</view>
  </view>

  <view class="content">
    <!-- 用户信息卡片 -->
    <view class="user-card glass-card" bindtap="editProfile">
      <view class="avatar-container">
        <view class="avatar">
          {{userInfo.avatar ? '' : userInfo.username.charAt(0)}}
        </view>
      </view>
      <view class="user-info">
        <view class="username">{{userInfo.username}}</view>
        <view class="user-bio">{{userInfo.bio}}</view>
      </view>
      <view class="user-arrow">›</view>
    </view>

    <!-- 数据统计卡片 -->
    <view class="stats-grid">
      <view class="stat-card glass-card" bindtap="goToFavorites">
        <view class="stat-icon">♥</view>
        <view class="stat-number">{{stats.favoriteCount}}</view>
        <view class="stat-label">我的喜欢</view>
      </view>

      <view class="stat-card glass-card" bindtap="goToHistory">
        <view class="stat-icon">🕐</view>
        <view class="stat-number">{{stats.historyCount}}</view>
        <view class="stat-label">浏览历史</view>
      </view>

      <view class="stat-card glass-card" bindtap="goToRatings">
        <view class="stat-icon">⭐</view>
        <view class="stat-number">{{stats.ratingCount}}</view>
        <view class="stat-label">我的评分</view>
      </view>
    </view>

    <!-- 设置列表 -->
    <view class="settings-section">
      <view class="section-title">设置</view>
      <view class="settings-list">
        <view class="settings-item" bindtap="goToBackgroundSettings">
          <view class="settings-icon">🎨</view>
          <view class="settings-label">背景设置</view>
          <view class="settings-arrow">›</view>
        </view>

        <view class="settings-item" bindtap="goToSettings">
          <view class="settings-icon">⚙️</view>
          <view class="settings-label">偏好设置</view>
          <view class="settings-arrow">›</view>
        </view>

        <view class="settings-item" bindtap="share">
          <view class="settings-icon">📤</view>
          <view class="settings-label">分享给朋友</view>
          <view class="settings-arrow">›</view>
        </view>

        <view class="settings-item" bindtap="goToHelp">
          <view class="settings-icon">❓</view>
          <view class="settings-label">帮助与反馈</view>
          <view class="settings-arrow">›</view>
        </view>
      </view>
    </view>

    <!-- 版本号 -->
    <view class="version-text">Mixology v1.0.0</view>
  </view>
</view>
