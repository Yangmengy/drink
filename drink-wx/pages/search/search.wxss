/* pages/search/search.wxss */
.page {
  min-height: 100vh;
  background: var(--bg-page);
}

/* 搜索栏 */
.search-bar {
  padding: var(--spacing-md);
  background: #fff;
  border-bottom: 2rpx solid var(--border-color);
}

.search-input-wrapper {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.search-input {
  flex: 1;
  padding: 20rpx 32rpx;
  background: var(--bg-page);
  border-radius: var(--radius-large);
  font-size: 28rpx;
}

.search-btn {
  padding: 20rpx 32rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: var(--radius-large);
  font-size: 28rpx;
}

/* 搜索结果 */
.results-section {
  padding: var(--spacing-md);
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: var(--spacing-md);
}

.result-item {
  display: flex;
  padding: var(--spacing-md);
  background: var(--bg-card);
  border-radius: var(--radius-medium);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-light);
}

.result-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-medium);
  margin-right: var(--spacing-md);
  flex-shrink: 0;
}

.result-info {
  flex: 1;
}

.result-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.result-desc {
  font-size: 26rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 建议区域 */
.suggestions {
  padding: var(--spacing-md);
}

.history-section,
.hot-section {
  margin-bottom: var(--spacing-xl);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.clear-btn {
  font-size: 24rpx;
  color: var(--text-tertiary);
  padding: 8rpx 16rpx;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.tag {
  padding: 16rpx 32rpx;
  background: var(--bg-card);
  border-radius: var(--radius-large);
  font-size: 26rpx;
  color: var(--text-secondary);
  box-shadow: var(--shadow-light);
}

.tag.hot {
  background: linear-gradient(135deg, #FFF5E6, #FFE6CC);
  color: var(--primary-color);
}
