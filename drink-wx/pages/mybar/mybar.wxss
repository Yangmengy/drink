/* pages/mybar/mybar.wxss - 1:1 复原原版酒柜设计 */

.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--bg-page);
  overflow: hidden;
  height: 100vh;
  padding-bottom: 120rpx;
}

/* ========== 导航栏 ========== */
.navbar {
  padding: 24rpx 40rpx;
  background: var(--bg-page);
  flex-shrink: 0;
}

.navbar-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.navbar-subtitle {
  font-size: 22rpx;
  color: var(--text-tertiary);
  font-weight: 600;
  letter-spacing: 0.1em;
  margin-top: 4rpx;
}

/* ========== 搜索栏 ========== */
.search-container {
  padding: 0 40rpx 30rpx;
  background: var(--bg-page);
  flex-shrink: 0;
}

.search-bar {
  display: flex;
  align-items: center;
  background: white;
  padding: 20rpx 32rpx;
  border-radius: var(--radius-large);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.03);
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.4;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.search-input::placeholder {
  color: var(--text-tertiary);
}

/* ========== 主布局 ========== */
.layout {
  flex: 1;
  display: flex;
  overflow: hidden;
  position: relative;
  min-height: 0;
}

/* ========== 左侧分类导航 ========== */
.sidebar {
  width: 170rpx;
  background: rgba(255, 255, 255, 0.5);
  overflow-y: auto;
  overflow-x: hidden;
  border-right: 1rpx solid rgba(0, 0, 0, 0.03);
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  flex-shrink: 0;
}

.sidebar::-webkit-scrollbar {
  display: none;
}

.cat-button {
  padding: 24rpx 8rpx;
  border-radius: var(--radius-medium);
  background: transparent;
  color: var(--text-secondary);
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  transition: all 0.2s;
}

.cat-button.active {
  background: white;
  color: var(--color-accent);
  font-weight: 700;
  box-shadow: var(--shadow-sm);
}

/* ========== 右侧原料网格 ========== */
.list-container {
  flex: 1;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 32rpx;
  background: var(--bg-page);
  min-width: 0;
}

.loading {
  text-align: center;
  color: var(--text-tertiary);
  margin-top: 80rpx;
  font-size: 28rpx;
}

.grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24rpx;
  align-items: stretch;
}

/* ========== 原料卡片 ========== */
.ingredient-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  background: white;
  border-radius: var(--radius-large);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
  transition: all 0.2s;
  border: 1rpx solid transparent;
  text-align: center;
  height: 100%;
}

.ingredient-card.owned {
  border-color: rgba(78, 205, 196, 0.5);
  background: rgba(78, 205, 196, 0.05);
}

.ingredient-card:active {
  transform: scale(0.95);
}

.icon-container {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  background: var(--bg-secondary);
  border-radius: var(--radius-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.icon {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-size: 64rpx;
}

.ingredient-card.owned .icon-container {
  background: white;
}

.check-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background: var(--color-accent);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid white;
  box-shadow: var(--shadow-sm);
  font-size: 28rpx;
  font-weight: 700;
}

.info {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  flex: 1;
}

.name {
  width: 100%;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text-primary);
  text-align: center;
  word-wrap: break-word;
  word-break: break-word;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  line-clamp: 3;
  overflow: hidden;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
