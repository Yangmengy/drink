<!--pages/mybar/mybar.wxml - 1:1 复原原版酒柜设计-->
<view class="page">
  <!-- 导航栏 -->
  <view class="navbar">
    <view class="navbar-title">原料库</view>
    <view class="navbar-subtitle">INGREDIENTS</view>
  </view>

  <!-- 搜索栏 -->
  <view class="search-container">
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        type="text" 
        placeholder="搜索原料..."
        value="{{searchQuery}}"
        bindinput="onSearchInput"
      />
    </view>
  </view>

  <!-- 主布局：左侧分类 + 右侧网格 -->
  <view class="layout">
    <!-- 左侧分类导航 -->
    <view class="sidebar">
      <view 
        wx:for="{{categories}}" 
        wx:key="id"
        class="cat-button {{selectedCategory === item.id ? 'active' : ''}}"
        data-category="{{item.id}}"
        bindtap="onCategoryTap"
      >
        {{item.name}}
      </view>
    </view>

    <!-- 右侧原料网格 -->
    <view class="list-container">
      <view wx:if="{{loading}}" class="loading">加载中...</view>
      
      <view wx:else class="grid">
        <block wx:for="{{allIngredients}}" wx:key="id">
          <view 
            wx:if="{{(selectedCategory === 'all' || item.category === selectedCategory) && (searchQuery === '' || item.name_zh.indexOf(searchQuery) >= 0 || (item.name_en && item.name_en.toLowerCase().indexOf(searchQuery.toLowerCase()) >= 0))}}"
            class="ingredient-card {{ownedIds.indexOf(item.id) >= 0 ? 'owned' : ''}}"
            data-id="{{item.id}}"
            bindtap="toggleOwned"
          >
            <view class="icon-container">
              <text class="icon">
                {{item.category === 'spirit' ? '🥃' : 
                  item.category === 'liqueur' ? '🍾' :
                  item.category === 'juice' ? '🧃' :
                  item.category === 'mixer' ? '🥤' :
                  item.category === 'syrup' ? '🍯' :
                  item.category === 'herb' ? '🌿' :
                  item.category === 'garnish' ? '🍋' :
                  item.category === 'ice' ? '🧊' : '🍹'}}
              </text>
              <view wx:if="{{ownedIds.indexOf(item.id) >= 0}}" class="check-badge">✓</view>
            </view>
            <view class="info">
              <view class="name">{{item.name_zh}}</view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </view>
</view>
