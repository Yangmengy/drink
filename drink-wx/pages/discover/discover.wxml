<!--pages/discover/discover.wxml - 原版设计复原-->
<view class="page">
  <!-- 导航栏 -->
  <view class="navbar">
    <view class="navbar-title">Mixology</view>
  </view>

  <view class="content">
    <!-- 搜索栏 -->
    <view class="search-bar" bindtap="goToSearch">
      <view class="search-icon">🔍</view>
      <text class="search-placeholder">搜索鸡尾酒、原料、配方...</text>
    </view>

    <!-- 卡片并排：今日灵感 + AI调酒师 -->
    <view class="cards-row">
      <!-- 今日灵感卡片 -->
      <view class="inspiration-card glass-card" bindtap="showInspiration">
        <view class="card-icon">🍸</view>
        <view class="card-content">
          <view class="card-title">今日灵感</view>
          <view class="card-desc">发现 {{canMakeCount}} 款可调制</view>
          <view class="card-link">查看推荐 →</view>
        </view>
      </view>

      <!-- AI调酒师卡片 -->
      <view class="ai-card glass-card" bindtap="goToAI">
        <view class="card-icon">🤖</view>
        <view class="card-content">
          <view class="card-title">AI 调酒师</view>
          <view class="card-desc">分析心情和偏好</view>
          <view class="card-link">召唤调酒师 →</view>
        </view>
      </view>
    </view>

    <!-- 热门推荐 -->
    <view class="section">
      <view class="section-title">热门推荐</view>
      <scroll-view class="recommend-scroll" scroll-x>
        <view 
          wx:for="{{featuredRecipes}}" 
          wx:key="id"
          class="recommend-card"
          data-id="{{item.id}}"
          bindtap="goToRecipe"
        >
          <view class="recommend-placeholder">🍸</view>
          <view class="recommend-info">
            <view class="recommend-name">{{item.name_zh}}</view>
            <view class="recommend-en">{{item.name_en}}</view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 分类浏览 -->
    <view class="section">
      <view class="section-title">分类浏览</view>
      <scroll-view class="category-scroll" scroll-x>
        <view 
          wx:for="{{categories}}" 
          wx:key="id"
          class="category-tag {{selectedCategory === item.id ? 'active' : ''}}"
          data-category="{{item.id}}"
          bindtap="onCategoryTap"
        >
          {{item.name}}
        </view>
      </scroll-view>
    </view>

    <!-- 配方网格 -->
    <view class="recipe-grid">
      <view 
        wx:for="{{recipes}}" 
        wx:key="id"
        class="recipe-card glass-card"
        data-id="{{item.id}}"
        bindtap="goToRecipe"
      >
        <view class="recipe-image">🍸</view>
        <view class="recipe-info">
          <view class="recipe-name">{{item.name_zh}}</view>
          <view class="recipe-en">{{item.name_en}}</view>
          <view class="recipe-meta">
            <text class="recipe-abv">{{item.abv}}%</text>
            <text class="recipe-difficulty">难度: {{item.difficulty}}</text>
          </view>
        </view>
        <view wx:if="{{item.is_favorite}}" class="favorite-badge">♥</view>
      </view>
    </view>
  </view>
</view>
