/* pages/discover/discover.wxss - 1:1 复原原版设计 */

.page {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: 120rpx;
}

/* ========== 导航栏 ========== */
.navbar {
  padding: 24rpx 40rpx;
  background: var(--bg-page);
}

.navbar-title {
  font-size: 48rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.02em;
}

/* ========== 内容区 ========== */
.content {
  padding: 0 40rpx;
}

/* ========== 搜索栏 ========== */
.search-bar {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--bg-elevated);
  backdrop-filter: blur(48rpx) saturate(180%);
  border-radius: var(--radius-large);
  border: 1rpx solid var(--border-glass);
  box-shadow: var(--shadow-sm);
  margin-bottom: 30rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  opacity: 0.4;
}

.search-placeholder {
  color: var(--text-tertiary);
  font-size: 28rpx;
}

/* ========== 并排卡片容器 ========== */
.cards-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

/* ========== 统一毛玻璃卡片样式 ========== */
.glass-card {
  position: relative;
  border-radius: var(--radius-large);
  overflow: hidden;
  background: var(--bg-elevated);
  backdrop-filter: blur(48rpx) saturate(180%);
  border: 1rpx solid var(--border-glass);
  box-shadow: var(--shadow-lg);
  transition: all 0.3s ease;
}

.glass-card:active {
  transform: scale(0.97);
  box-shadow: var(--shadow-xl);
}

/* ========== 今日灵感 & AI调酒师卡片 ========== */
.inspiration-card,
.ai-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 36rpx 24rpx;
  gap: 20rpx;
  text-align: center;
}

.card-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: var(--radius-medium);
  background: linear-gradient(145deg, rgba(78, 205, 196, 0.18), rgba(255, 107, 107, 0.1));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.3),
              0 8rpx 32rpx rgba(78, 205, 196, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.card-content {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -0.02em;
}

.card-desc {
  font-size: 24rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.card-link {
  font-size: 26rpx;
  color: var(--color-accent);
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
}

/* ========== Section ========== */
.section {
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 24rpx;
  letter-spacing: -0.01em;
}

/* ========== 热门推荐横向滚动 ========== */
.recommend-scroll {
  display: flex;
  white-space: nowrap;
  overflow-x: scroll;
  -webkit-overflow-scrolling: touch;
  padding: 4rpx 0 12rpx;
  margin: 0 -40rpx;
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.recommend-scroll::-webkit-scrollbar {
  display: none;
}

.recommend-card {
  display: inline-block;
  width: 240rpx;
  margin-right: 24rpx;
  background: var(--bg-elevated);
  backdrop-filter: blur(48rpx) saturate(180%);
  border-radius: var(--radius-large);
  border: 1rpx solid var(--border-glass);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
  transition: all 0.3s ease;
}

.recommend-card:active {
  transform: scale(0.95);
  box-shadow: var(--shadow-md);
}

.recommend-placeholder {
  width: 100%;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  background: linear-gradient(145deg, rgba(78, 205, 196, 0.08), rgba(255, 107, 107, 0.06));
}

.recommend-info {
  padding: 20rpx;
  text-align: center;
}

.recommend-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  white-space: normal;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.recommend-en {
  font-size: 22rpx;
  color: var(--text-tertiary);
  text-transform: capitalize;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ========== 分类标签横向滚动 ========== */
.category-scroll {
  display: flex;
  white-space: nowrap;
  overflow-x: scroll;
  -webkit-overflow-scrolling: touch;
  padding: 4rpx 0;
  margin: 0 -40rpx;
  padding-left: 40rpx;
  padding-right: 40rpx;
  gap: 16rpx;
}

.category-scroll::-webkit-scrollbar {
  display: none;
}

.category-tag {
  display: inline-flex;
  align-items: center;
  padding: 14rpx 28rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(24rpx);
  border: 1rpx solid var(--border-glass);
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  transition: all 0.3s ease;
  white-space: nowrap;
}

.category-tag.active {
  background: var(--color-accent);
  color: white;
  font-weight: 600;
  border-color: var(--color-accent);
  box-shadow: 0 4rpx 16rpx rgba(78, 205, 196, 0.25);
}

/* ========== 2列网格配方卡片 ========== */
.recipe-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 32rpx;
}

.recipe-card {
  position: relative;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.recipe-image {
  width: 100%;
  height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  background: linear-gradient(145deg, rgba(78, 205, 196, 0.08), rgba(255, 107, 107, 0.06));
  border-radius: var(--radius-large) var(--radius-large) 0 0;
}

.recipe-info {
  padding: 24rpx;
  background: var(--bg-elevated);
  border-radius: 0 0 var(--radius-large) var(--radius-large);
  border: 1rpx solid var(--border-glass);
  border-top: none;
  backdrop-filter: blur(48rpx) saturate(180%);
}

.recipe-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
}

.recipe-en {
  font-size: 22rpx;
  color: var(--text-tertiary);
  margin-bottom: 12rpx;
  text-transform: capitalize;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recipe-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
}

.recipe-abv {
  color: var(--color-accent);
  font-weight: 600;
}

.recipe-difficulty {
  color: var(--text-tertiary);
}

/* ========== 收藏心形图标 ========== */
.favorite-badge {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(16rpx);
  border-radius: 50%;
  color: #FF6B6B;
  font-size: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: all 0.3s ease;
}

.favorite-badge:active {
  transform: scale(0.9);
}
