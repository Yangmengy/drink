# Copy this file to deploy/.env on the server and replace both values.
# Generate POSTGRES_PASSWORD with `openssl rand -hex 24` so it is URL-safe.
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Keep this as 127.0.0.1 until HTTPS is configured. Access the API through an
# SSH tunnel, or temporarily set it to 0.0.0.0 if you accept plaintext traffic.
API_BIND=127.0.0.1
API_PORT=8080

# Browser origins allowed to call the API directly. The web deployment serves
# the frontend and API on the same origin, but keep local development allowed.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
